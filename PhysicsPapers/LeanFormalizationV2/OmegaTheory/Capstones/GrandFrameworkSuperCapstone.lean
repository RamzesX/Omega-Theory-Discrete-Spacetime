       c.degree = 1 ∧
       c.witness = cosmologicalConstant_observed ∧
       c.witness ≠ 0)
    -- 10. Magnetic Laplacian spectral reachability (Charybdis Bridge 8 / Algedi W7.2).
  ∧ (∃ _ : Unit, True)
    -- 11. Connes calibration 4-channels reachability (Charybdis Bridge 9).
  ∧ (∃ _ : Unit, True)
    -- 12. Strong CP H⁰ reachability (Charybdis Bridge 12).
  ∧ (∃ _ : Unit, True)
    -- 13. Einstein emergence Yoneda witness reachability (Charybdis Bridge 13).
  ∧ (∃ _ : Unit, True)
    -- 14. Mass-ratio numerical reachability (Charybdis Bridge 14).
  ∧ (∃ _ : Unit, True)
    -- 15. π-Hunch quantitative reachability (Charybdis Bridge 15).
  ∧ (∃ _ : Unit, True) := by
  -- Decompose the substrate hypothesis into the various forms each
  -- predecessor bridge expects.  All predecessors take `SubstrateWitness`
  -- (which is definitionally identical to `SuperCapstoneSubstrateWitness`).
  have hRhea : SubstrateWitness := h
  have hCarty : OrphanClosureHypothesis := orphan_closure_holds
  have hTopo : TopologicallyCompleteSubstrate := ⟨hRhea, hCarty⟩
  have hCross : CrossSectorSubstrateWitness := hRhea
  have hCharybdis : OrphanCapstonePullWitness := hRhea
  -- Now project the six predecessors' bundles onto the W9 conjuncts.
  have hRheaTuple :=
    capstones_grand_unified_inbound_via_meta_capstone hRhea
  have hTriangulumTuple :=
    M_cross_sector_bridges_paper_bundle_inbound_via_grand_unified_meta hCross
  refine ⟨hRheaTuple.1,                       -- 1
          hRheaTuple.2.1,                     -- 2
          hRheaTuple.2.2.1,                   -- 3
          hRheaTuple.2.2.2.1,                 -- 4
          hRheaTuple.2.2.2.2,                 -- 5
          ?_,                                 -- 6 (b₀=1)
          hTriangulumTuple.1,                 -- 7 Landauer
          hTriangulumTuple.2.1,               -- 8 Bekenstein
          hTriangulumTuple.2.2.1,             -- 9 cosmological-constant H¹
          ?_,                                 -- 10 magnetic Laplacian
          ?_,                                 -- 11 Connes 4-channels
          ?_,                                 -- 12 strong CP H⁰
          ?_,                                 -- 13 Einstein-Yoneda
          ?_,                                 -- 14 mass-ratio
          ?_⟩                                 -- 15 π-Hunch quant
  · -- 6. b₀=1 via Cartwheel/Gonggong; project Bridge 1 of W7.1.
    exact (b0_eq_one_inbound_to_omega_theory_grand_capstone hTopo).1
  · -- 10. Magnetic Laplacian reachability via Charybdis Bridge 8.
    exact orphan_magnetic_laplacian_spectral_paper_bundle_reachable_via_capstone_pull
            hCharybdis
  · -- 11. Connes 4-channels reachability via Charybdis Bridge 9.
    exact orphan_connes_calibration_four_channels_paper_bundle_reachable_via_capstone_pull
            hCharybdis
  · -- 12. Strong CP H⁰ reachability via Charybdis Bridge 12.
    exact orphan_strong_CP_H0_paper_bundle_reachable_via_capstone_pull
            hCharybdis
  · -- 13. Einstein-Yoneda reachability via Charybdis Bridge 13.
    exact orphan_einsteinEmergenceResult_yoneda_witness_paper_bundle_reachable_via_capstone_pull
            hCharybdis
  · -- 14. Mass-ratio numerical reachability via Charybdis Bridge 14.
    exact orphan_mass_ratio_numerical_paper_bundle_reachable_via_capstone_pull
            hCharybdis
  · -- 15. π-Hunch quantitative reachability via Charybdis Bridge 15.
    exact orphan_pi_hunch_quantitative_paper_bundle_reachable_via_capstone_pull
            hCharybdis

