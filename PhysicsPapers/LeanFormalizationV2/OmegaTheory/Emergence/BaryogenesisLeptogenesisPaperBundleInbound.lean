/-- **GRAND ALIAS — `baryogenesis_leptogenesis_inbound_witness`.**

    There exists a substrate truncation budget `N` (with the Sakharov
    triple realised) under which the five matter-asymmetry paper-
    bundle headlines hold:

      * cycle-20 Deneb Algedi `baryogenesis_sakharov_substrate`
        (5-conjunct);
      * cycle-33 Alkes `baryogenesis_from_sakharov_plus_catalanG`
        (4-conjunct);
      * cycle-33 Alkes `baryogenesis_leptogenesis_paper_bundle`
        (4-conjunct);
      * cycle-41+42 Ruchbah `matter_asymmetry_and_no_new_physics_paper_bundle`
        (3-conjunct);
      * cycle-59 W7 Mimosa `baryogenesis_eta_B_paper_bundle_window`
        (3-conjunct).

    Each bundle holds outright; the witness packages them under a
    single Sakharov-realisation hypothesis to provide a single
    citation point and force inbound APPLIES edges into all five
    paper bundles simultaneously. -/
theorem baryogenesis_leptogenesis_inbound_witness :
    ∃ N : ℕ,
      sakharov_realised_at_truncation N ∧
      -- bridge #1 (cycle-20)
      (SakharovBViolation ∧
        SakharovCPViolation (substrateJarlskog N_J_anchor) ∧
        SakharovOutOfEquilibrium
          (substrateBaryonPhotonRatio N_eta_anchor) ∧
        (SakharovBViolation ∧
          SakharovCPViolation jarlskogPDG_val ∧
          SakharovOutOfEquilibrium eta_bary) ∧
        deltaCP_fit ≠ 0) ∧
      -- bridge #2 (cycle-33 sakharov+catalanG)
      (0 < eta_B_substrate N ∧
        eta_B_substrate N = baryonPhotonRatio_PDG +
                             delta_sphaleron_catalan N ∧
        delta_sphaleron_catalan N =
            C_sphaleron * catalanGTruncError N ∧
        |eta_B_substrate N - baryonPhotonRatio_PDG| < 1e-9) ∧
      -- bridge #3 (cycle-33 paper bundle)
      ((|eta_B_substrate N - baryonPhotonRatio_PDG| < 1e-9) ∧
        (0 < epsilon_sterile_asymmetry) ∧
        (0 < BR_substrate N) ∧
        (Fintype.card SU3ColorChannel = 3 ∧
          Function.Bijective channelToGeneration4 ∧
          channelToGeneration4 .catalan_g = (3 : Fin 4))) ∧
      -- bridge #4 (cycle-41+42 paper bundle)
      ((∃ ε : ℝ,
         0 < ε ∧ ε < 1 ∧
         |eta_B_substrate N - baryonPhotonRatio_PDG|
           ≤ ε * baryonPhotonRatio_PDG) ∧
        (∀ m : ℝ,
           sterile_window_upper < m → m < m_e_eV →
           ¬ FermionCatalogue.exists_at_mass m) ∧
        (Function.Bijective channelToGeneration4 ∧
          channelToGeneration4 .catalan_g = (3 : Fin 4))) ∧
      -- bridge #5 (cycle-59 W7)
      (0 < eta_B_substrate N ∧
        eta_B_substrate N ≤ baryonPhotonRatio_PDG + C_sphaleron ∧
        |eta_B_substrate N - baryonPhotonRatio_PDG|
          ≤ leptogenesis_CP_envelope * baryonPhotonRatio_PDG) := by
  obtain ⟨N, hN⟩ := sakharov_realised_at_truncation_witness
  refine ⟨N, hN,
    baryogenesis_sakharov_substrate_inbound hN,
    baryogenesis_from_sakharov_plus_catalanG_inbound hN,
    baryogenesis_leptogenesis_paper_bundle_inbound hN,
    matter_asymmetry_and_no_new_physics_paper_bundle_inbound hN,
