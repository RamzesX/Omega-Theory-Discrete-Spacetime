      eta_B_substrate N ≤ baryonPhotonRatio_PDG + C_sphaleron ∧
      |eta_B_substrate N - baryonPhotonRatio_PDG|
        ≤ leptogenesis_CP_envelope * baryonPhotonRatio_PDG) :=
  ⟨baryogenesis_sakharov_substrate_inbound hN,
   baryogenesis_from_sakharov_plus_catalanG_inbound hN,
   baryogenesis_leptogenesis_paper_bundle_inbound hN,
   matter_asymmetry_and_no_new_physics_paper_bundle_inbound hN,
   baryogenesis_eta_B_paper_bundle_window_inbound hN⟩

