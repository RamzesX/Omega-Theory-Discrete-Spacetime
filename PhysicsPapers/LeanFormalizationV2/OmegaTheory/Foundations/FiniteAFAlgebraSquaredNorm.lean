import OmegaTheory.Foundations.FiniteAFAlgebra
import OmegaTheory.Foundations.FiniteAFAlgebraMul
import OmegaTheory.Foundations.FiniteAFAlgebraAdjoint
import OmegaTheory.Foundations.FiniteAFAlgebraSMul
import Mathlib.Tactic
import Mathlib.Data.Real.Basic

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.style.show false

namespace OmegaTheory.Foundations.FiniteAFAlgebraSquaredNorm

open OmegaTheory.Foundations.FiniteAFAlgebra
open OmegaTheory.Foundations.FiniteAFAlgebraMul
open OmegaTheory.Foundations.FiniteAFAlgebraAdjoint
open OmegaTheory.Foundations.FiniteAFAlgebraSMul

/-! ## 1. The squared-norm at c_part -/

/-- **c_part squared-norm**:
    `‖a‖²|c := a.c_part.1² + a.c_part.2²`.

    This is the standard ℝ²-Euclidean / ℂ-modulus squared on the
    ℂ-component of A_F = ℂ ⊕ ℍ ⊕ M_3(ℂ). -/
def cPartSquaredNorm (a : FiniteAFAlgebra) : ℝ :=
  a.c_part.1^2 + a.c_part.2^2

/-! ## 2. Non-negativity and zero/one normalization -/

/-- **Squared-norm at c_part is non-negative**:
    `0 ≤ ‖a‖²|c`. -/
theorem cPartSquaredNorm_nonneg (a : FiniteAFAlgebra) :
    0 ≤ cPartSquaredNorm a := by
  unfold cPartSquaredNorm
  positivity

/-- **Squared-norm of zero**: `‖0‖²|c = 0`. -/
theorem cPartSquaredNorm_zero :
    cPartSquaredNorm (0 : FiniteAFAlgebra) = 0 := by
  show (0 : ℝ)^2 + (0 : ℝ)^2 = 0
  ring

/-- **Squared-norm of one**: `‖1‖²|c = 1`. -/
theorem cPartSquaredNorm_one :
    cPartSquaredNorm (1 : FiniteAFAlgebra) = 1 := by
  show (1 : ℝ)^2 + (0 : ℝ)^2 = 1
  ring

/-! ## 3. ℝ-scalar quadratic homogeneity -/

/-- **Squared-norm scalar quadratic homogeneity**:
    `‖r • a‖²|c = r² · ‖a‖²|c`. -/
theorem cPartSquaredNorm_smul (r : ℝ) (a : FiniteAFAlgebra) :
    cPartSquaredNorm (r • a) = r^2 * cPartSquaredNorm a := by
  show (r * a.c_part.1)^2 + (r * a.c_part.2)^2 =
       r^2 * (a.c_part.1^2 + a.c_part.2^2)
  ring

/-! ## 4. Adjoint invariance -/

/-- **Squared-norm is adjoint-invariant at c_part**:
    `‖adj a‖²|c = ‖a‖²|c`.

    Reflects the standard fact that complex conjugation preserves
    the modulus: `|z*| = |z|`, hence `|z*|² = |z|²`. -/
theorem cPartSquaredNorm_adj (a : FiniteAFAlgebra) :
    cPartSquaredNorm (adj a) = cPartSquaredNorm a := by
  show (a.c_part.1)^2 + (-a.c_part.2)^2 = a.c_part.1^2 + a.c_part.2^2
  ring

/-! ## 5. Headline composite report -/

/-- **Lion's-Pride Phase 6.5n headline — finite Chamseddine-Connes
    A_F algebra squared-norm structural report at c_part.**

    For any scalar `r : ℝ` and any element `a : FiniteAFAlgebra`:

    1. **Non-negativity**:
       `0 ≤ ‖a‖²|c`.

    2. **Zero normalization**:
       `‖0‖²|c = 0`.

    3. **One normalization**:
       `‖1‖²|c = 1`.

    4. **Scalar quadratic homogeneity**:
       `‖r • a‖²|c = r² · ‖a‖²|c`.

    5. **Adjoint invariance**:
       `‖adj a‖²|c = ‖a‖²|c`. -/
theorem finite_AF_algebra_squared_norm_report (r : ℝ) (a : FiniteAFAlgebra) :
    0 ≤ cPartSquaredNorm a ∧
    cPartSquaredNorm (0 : FiniteAFAlgebra) = 0 ∧
    cPartSquaredNorm (1 : FiniteAFAlgebra) = 1 ∧
    cPartSquaredNorm (r • a) = r^2 * cPartSquaredNorm a ∧
    cPartSquaredNorm (adj a) = cPartSquaredNorm a := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact cPartSquaredNorm_nonneg a
  · exact cPartSquaredNorm_zero
  · exact cPartSquaredNorm_one
  · exact cPartSquaredNorm_smul r a
  · exact cPartSquaredNorm_adj a

end OmegaTheory.Foundations.FiniteAFAlgebraSquaredNorm
