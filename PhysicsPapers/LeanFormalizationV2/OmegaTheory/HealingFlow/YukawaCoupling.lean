/-! ## 1. Yukawa fermion mass formula

Substrate fermion mass via the Yukawa coupling:

    m_f(y, N)  :=  y · higgs_vev(N) / √2

Both `higgs_vev` and `√2` are positive, so `m_f` is well-defined
and `0 ≤ m_f` for `y ≥ 0`. -/

/-- **Substrate fermion mass via Yukawa coupling**:
    `m_f := y · higgs_vev(N) / √2`. -/
noncomputable def yukawaFermionMass (y : ℝ) (N : ℕ) : ℝ :=
  y * higgs_vev N / Real.sqrt 2

/-! ## 2. Positivity

For `y > 0`, the Yukawa fermion mass is strictly positive at every
iteration `N` (`higgs_vev N > 0` from Phase 3 substrate spine). -/

/-- **`√2` is strictly positive**. -/
theorem sqrt_two_pos : 0 < Real.sqrt 2 :=
  Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 2)

/-- **`√2 ≠ 0`**. -/
theorem sqrt_two_ne_zero : Real.sqrt 2 ≠ 0 :=
  ne_of_gt sqrt_two_pos

/-- **Yukawa fermion mass is strictly positive** when `y > 0`. -/
theorem yukawaFermionMass_pos {y : ℝ} (hy : 0 < y) (N : ℕ) :
    0 < yukawaFermionMass y N := by
  unfold yukawaFermionMass
  apply div_pos
  · exact mul_pos hy (higgs_vev_pos N)
  · exact sqrt_two_pos

/-- **Yukawa fermion mass is non-negative** when `y ≥ 0`. -/
theorem yukawaFermionMass_nonneg {y : ℝ} (hy : 0 ≤ y) (N : ℕ) :
    0 ≤ yukawaFermionMass y N := by
  unfold yukawaFermionMass
  apply div_nonneg
  · exact mul_nonneg hy (le_of_lt (higgs_vev_pos N))
  · exact Real.sqrt_nonneg _

/-! ## 3. Substrate closed form: `m_f = y · δ_comp / √2` -/

/-- **Closed-form substrate Yukawa fermion mass**:
    `m_f = y · computationalUncertainty(N) / √2`. -/
theorem yukawaFermionMass_eq (y : ℝ) (N : ℕ) :
    yukawaFermionMass y N = y * computationalUncertainty N / Real.sqrt 2 := by
  unfold yukawaFermionMass higgs_vev
  rfl

/-! ## 4. Decreasing-with-N

More substrate iterations ⟶ smaller δ_comp(N) ⟶ smaller
fermion mass.  Consistent with high-energy symmetry restoration:
in the high-`N` (high computational precision) limit, the
substrate VEV vanishes and so does the fermion mass. -/

/-- **Yukawa fermion mass decreases with `N`** for `y ≥ 0`.

    Direct from `higgs_vev_decreasing` and division-monotonicity. -/
theorem yukawaFermionMass_decreasing {y : ℝ} (hy : 0 ≤ y) (N : ℕ) :
    yukawaFermionMass y (N + 1) ≤ yukawaFermionMass y N := by
  unfold yukawaFermionMass
  apply div_le_div_of_nonneg_right _ (le_of_lt sqrt_two_pos)
  exact mul_le_mul_of_nonneg_left (higgs_vev_decreasing N) hy

/-! ## 5. Mass-squared form

Useful corollary: `m_f² = y² · v² / 2`. -/

/-- **Yukawa fermion mass-squared**:
    `m_f² = y² · higgs_vev² / 2`. -/
theorem yukawaFermionMass_sq (y : ℝ) (N : ℕ) :
    (yukawaFermionMass y N)^2 = y^2 * (higgs_vev N)^2 / 2 := by
  unfold yukawaFermionMass
  rw [div_pow]
  -- Goal: (y * higgs_vev N)^2 / (Real.sqrt 2)^2 = y^2 * higgs_vev N^2 / 2
  have hsqrt2_sq : (Real.sqrt 2)^2 = 2 := Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)
  rw [hsqrt2_sq]
  ring

/-- **Yukawa fermion mass-squared is non-negative**. -/
theorem yukawaFermionMass_sq_nonneg (y : ℝ) (N : ℕ) :
    0 ≤ (yukawaFermionMass y N)^2 := sq_nonneg _

/-- **Yukawa fermion mass-squared is strictly positive** for `y ≠ 0`. -/
theorem yukawaFermionMass_sq_pos {y : ℝ} (hy : y ≠ 0) (N : ℕ) :
    0 < (yukawaFermionMass y N)^2 := by
  rw [yukawaFermionMass_sq]
  have h_y_sq : 0 < y^2 := by positivity
  have h_v_sq : 0 < (higgs_vev N)^2 := by
    have := higgs_vev_pos N
    positivity
  have h_two_pos : (0 : ℝ) < 2 := by norm_num
  apply div_pos
  · exact mul_pos h_y_sq h_v_sq
  · exact h_two_pos

/-! ## 6. Headline composite report -/

/-- **Lion's-Pride Phase 4.4 headline — substrate Yukawa coupling
    fermion-mass report.**

    For Yukawa coupling `y > 0` and iteration `N`:

    1. `m_f(y, N) = y · computationalUncertainty(N) / √2`
       (closed form in substrate primitives).

    2. `0 < m_f(y, N)` (substrate fermion mass non-trivial).

    3. `m_f(y, N+1) ≤ m_f(y, N)` (decreasing with substrate iteration —
       high-energy symmetry restoration).

    4. `m_f²(y, N) = y² · v²(N) / 2`
       (mass-squared closed form, useful for kinetic-term bookkeeping). -/
theorem yukawa_substrate_report {y : ℝ} (hy : 0 < y) (N : ℕ) :
    yukawaFermionMass y N
      = y * computationalUncertainty N / Real.sqrt 2 ∧
    0 < yukawaFermionMass y N ∧
    yukawaFermionMass y (N + 1) ≤ yukawaFermionMass y N ∧
    (yukawaFermionMass y N)^2
      = y^2 * (higgs_vev N)^2 / 2 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact yukawaFermionMass_eq y N
  · exact yukawaFermionMass_pos hy N
  · exact yukawaFermionMass_decreasing (le_of_lt hy) N
  · exact yukawaFermionMass_sq y N

