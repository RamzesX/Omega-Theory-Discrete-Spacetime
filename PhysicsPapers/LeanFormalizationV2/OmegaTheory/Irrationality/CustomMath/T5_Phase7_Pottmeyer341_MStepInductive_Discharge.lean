    The witness `j₀` is now extracted INSIDE the proof (via Thuban THU-5),
    eliminated from the call surface. -/
theorem T5_hadar_sigma_form_at_m_plus_1_combined_regime_no_witness
    (m : ℕ) (hm : 1 ≤ m)
    (P : MvPolynomial (Fin (m + 1)) ℝ) (R : Fin (m + 1) → ℕ) (q : Fin (m + 1) → ℚ)
    (σ : ℝ) (hP : P ≠ 0)
    (hσ : 0 < σ) (hσ_le : σ ≤ 1/2)
    (hR_deg : ∀ i, MvPolynomial.degreeOf i P ≤ R i)
    (hR_pos : ∀ i, 0 < R i)
    (hq_den : ∀ i, 1 ≤ (q i).den)
    -- Small-σ-regime min-bound primitive (the SOLE residual after HADAR wiring):
    (h_min_bound_small_sigma_for :
      ∀ (j₀ : Fin (m + 1) → ℕ),
      aeval (fun i => ((q i : ℚ) : ℝ)) (multiIteratedPDeriv j₀ P) ≠ 0 →
      (∀ i, j₀ i ≤ R i) →
      (1 : ℝ) > 2 * σ ^ ((1 : ℝ) / (2 ^ ((m + 1) - 1) : ℝ)) →
      min (rothIndex P (fun i => ((q i : ℚ) : ℝ)) R)
          (rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ^ 2) ≤
      4 * ((m : ℝ)) * σ ^ ((1 : ℝ) / (2 ^ (m - 1) : ℝ)) + 4 * σ) :
    rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤
      2 * ((m + 1 : ℕ) : ℝ) * σ ^ ((1 : ℝ) / (2 ^ ((m + 1) - 1) : ℝ)) := by
  -- Step 1: m + 1 ≥ 1 trivially.
  have hm_plus_1 : 1 ≤ m + 1 := by omega
  -- Step 2: extract in-box witness via Thuban THU-5 (PHE-23 UNCONDITIONAL).
  obtain ⟨j₀, h_ne, h_box⟩ :=
    T5_hadar_pott_341_in_box_witness_primitive_unconditional hm_plus_1 P R q hP hR_deg hR_pos
  -- Step 3: apply Schedar SCH-13-1 with extracted witness.
  exact T5_schedar_sigma_form_at_m_plus_1_combined_regime m hm P R q σ hP hσ hσ_le hR_deg
    hR_pos hq_den j₀ h_ne h_box (h_min_bound_small_sigma_for j₀ h_ne h_box)

