/-! ## §C — CFC-3: 1-NAMED form via Schmidt JOINT-existential bridge

  The architecturally HONEST form (per Markab's literal-false discovery):
  the Schmidt joint hypothesis `T5_NAMED_Schmidt_joint` is the actually-true
  §D.7 content; the universal SM-2/SM-3 are unprovable.

  Note: the joint form provides EXISTENTIAL q_seq, while VVB-2's SM-2/SM-3
  consume UNIVERSAL q_seq. The joint cannot directly substitute into VVB-2
  without a stronger universal-shape hypothesis. We therefore formulate
  CFC-3 as an existential-form atom-2 variant rather than substituting
  into VVB-2's exact signature. The atom-2 caller must accept the
  existential form (which is what Hindry-Silverman §D.7 actually proves).
-/

/-- **CFC-3-PROP — `T5_RothBoundLargeFromMasterAndPigeonhole_existential_form`**:
    The atom-2 form quantified existentially over the Schmidt-tuple
    (m, P_int, q_seq) — the actually-true Hindry-Silverman §D.7 content.

    Whereas the universal-form SM-2/SM-3 used in V8→V6 bridge VVB-2 are
    LITERAL-FALSE per Markab's audit, this existential form bundles the
    jointly-chosen tuple into the conditional discharge target. -/
def T5_RothBoundLargeFromMasterAndPigeonhole_existential_form : Prop :=
  ∀ (α : ℝ), Irrational α → IsAlgebraic ℤ α →
  ∀ (ε : ℝ), 0 < ε →
  ∀ (_master : RothLemmaMaster),
  ∀ (_h_pigeon : T5_PigeonholeMTuple_Statement),
  ∃ (m : ℕ), 1 ≤ m ∧
  ∃ (P_int : MvPolynomial (Fin m) ℤ),
    (P_int.map (algebraMap ℤ ℝ) : MvPolynomial (Fin m) ℝ) ≠ 0 ∧
  ∃ (q_seq : ℕ → Fin m → ℚ),
    (∀ n j, q_seq n j ∈ T5_RothViolatingSet α ε) ∧
    (∀ n, T5_DegreeHeightBalanceCondition
          (fun j => MvPolynomial.degreeOf j (P_int.map (algebraMap ℤ ℝ)))
          (q_seq n) ε) ∧
    (∀ n, MvPolynomial.aeval (fun j => ((q_seq n j : ℚ) : ℝ))
          ((P_int.map (algebraMap ℤ ℝ)) : MvPolynomial (Fin m) ℝ) ≠ 0)

/-- **CFC-3-DISCHARGE — `T5_RothBoundLargeFromMasterAndPigeonhole_existential_form_via_joint`**:
    UNCONDITIONAL discharge of the existential-form atom-2 from the
    Schmidt joint hypothesis SJE-1.

    Strategy: extract from `T5_NAMED_Schmidt_joint` the (m, P_int, q_seq)
    bundle and the per-n balance + aeval-nonzero properties. Discard the
    rothIndex / growth / unboundedness components which are recovered
    elsewhere in the composition cascade (D4 + D5). -/
theorem T5_RothBoundLargeFromMasterAndPigeonhole_existential_form_via_joint
    (h_joint : T5_NAMED_Schmidt_joint) :
    T5_RothBoundLargeFromMasterAndPigeonhole_existential_form := by
  intros α hα h_alg ε hε _master _h_pigeon
  obtain ⟨m, hm, P_int, hP_ne, _hP_deg_pos, _hP_index, q_seq,
          h_violator, _h_growth, h_balance, h_aeval, _h_unbd⟩ :=
    h_joint α hα h_alg ε hε
  exact ⟨m, hm, P_int, hP_ne, q_seq, h_violator, h_balance, h_aeval⟩

