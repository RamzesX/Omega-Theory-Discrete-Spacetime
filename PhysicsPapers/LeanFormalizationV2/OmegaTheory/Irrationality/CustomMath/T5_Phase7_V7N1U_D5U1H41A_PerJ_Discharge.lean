    (h_rpow : T5_NAMED_V7N1U_D5U1H41A_rpow_bridge_step) :
    T5_NAMED_V7N1U_D5U1H41_perJ_point_bound := by
  intros α h_irr h_alg ε hε m hm P R h_P_ne h_deg h_R_pos h_index h_strict
  -- Extract κ from D5U1H41A-1
  obtain ⟨κ, hκ_gt_one, h_rpow_bound⟩ :=
    h_rpow α h_irr h_alg ε hε hm P R h_P_ne h_deg h_R_pos h_index h_strict
  -- Witness same κ
  refine ⟨κ, hκ_gt_one, ?_⟩
  intros q h_violator h_growth h_balance h_q_index J hJ_supp hJ_ne_zero
  -- Step 1: Convert J.support product to Finset.univ product
  rw [T5_V7N1U_D5U1H41A_support_eq_univ_product α q J]
  -- Step 2: Apply VC-9 to bound the universe product by ∏ d^(-(2+ε)·J_i)
  --   ∏ |q_i - α|^(J i) ≤ ∏ d_i^(-(2+ε) · (J i))
  -- VC-9 expects exponent vector j : Fin m → ℕ; we use J : Fin m →₀ ℕ via coe
  have h_VC9 :
      ∏ i, |((q i : ℚ) : ℝ) - α| ^ ((J : Fin m → ℕ) i) ≤
        ∏ i, ((q i).den : ℝ) ^ (-(2 + ε) * (((J : Fin m → ℕ) i : ℕ) : ℝ)) :=
    T5_tuple_violator_rpow_bound α ε q (fun i => J i) h_violator
  -- Step 3: Apply D5U1H41A-1 to bound the rpow side by (∏ d^R)^(-κ)
  have h_bridge :
      ∏ i, ((q i).den : ℝ) ^ (-(2 + ε) * (((J : Fin m → ℕ) i : ℕ) : ℝ)) ≤
        (∏ i, ((q i).den : ℝ) ^ (R i : ℕ)) ^ (-κ) :=
    h_rpow_bound q h_violator h_growth h_balance h_q_index J hJ_supp hJ_ne_zero
  -- Step 4: Combine via le_trans
  exact le_trans h_VC9 h_bridge

