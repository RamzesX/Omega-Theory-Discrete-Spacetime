/-! ## REG-1 — Universal D.6.1 quantifier-shape discharge under aeval-q-NE-zero -/

/-- **REG-1 — `T5_REGULUS_v8d5_aeval_q_ne_zero_universal`**: UNCONDITIONAL
    Type-(a) standalone discharge of `T5_RothLemmaIndexReduction_Statement`
    in the `aeval q P ≠ 0` regime, lifted to the FULL D.6.1 quantifier
    shape (with growth + balance + degreeOf + rothIndex_diag + smallness).

    For ALL `(m, P, R, α, q, ε, t)` matching the D.6.1 quantifier shape AND
    the structural condition `aeval q P ≠ 0` AND smallness `t ≥ √(mε)`,
    the V8-D5 inequality `rothIndex P (q-tuple) R ≤ t - √(mε)` holds
    UNCONDITIONALLY.

    Composes RASALHAGUE's RH-1a (instance-level UNCONDITIONAL when
    aeval ≠ 0) with the D.6.1 quantifier shape, providing the architectural
    universal form for V8-D5 closure under the dominant Schmidt-aux setup.

    UNCONDITIONAL — NO master, NO V8-D5 conditional. -/
theorem T5_REGULUS_v8d5_aeval_q_ne_zero_universal :
    ∀ {m : ℕ} (_ : 1 ≤ m)
      (P : MvPolynomial (Fin m) ℝ) (R : Fin m → ℕ)
      (α : ℝ) (q : Fin m → ℚ) (ε t : ℝ),
    P ≠ 0 →
    0 < ε →
    (∀ i, MvPolynomial.degreeOf i P ≤ R i) →
    (∀ i, 0 < R i) →
    (∀ i, 1 ≤ (q i).den) →
    T5_DenominatorGrowthCondition q ε →
    T5_DegreeHeightBalanceCondition R q ε →
    rothIndex P (fun _ => α) R ≥ t →
    Real.sqrt ((m : ℝ) * ε) ≤ t →
    aeval (fun i => ((q i : ℚ) : ℝ)) P ≠ 0 →
    rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤ t - Real.sqrt ((m : ℝ) * ε) := by
  intro m _ P R _ q ε t _ hε _ _ _ _ _ _ h_t h_aeval
  exact T5_HEART_lift_unconditional_when_aeval_q_ne_zero P R q ε t hε h_t h_aeval

/-- **REG-1-typed-a — Type-(a) standalone Prop form**. -/
def T5_REGULUS_v8d5_aeval_q_ne_zero_universal_typed_a : Prop :=
  ∀ {m : ℕ}, 1 ≤ m →
  ∀ (P : MvPolynomial (Fin m) ℝ) (R : Fin m → ℕ)
    (α : ℝ) (q : Fin m → ℚ) (ε t : ℝ),
    P ≠ 0 →
    0 < ε →
    (∀ i, MvPolynomial.degreeOf i P ≤ R i) →
    (∀ i, 0 < R i) →
    (∀ i, 1 ≤ (q i).den) →
    T5_DenominatorGrowthCondition q ε →
    T5_DegreeHeightBalanceCondition R q ε →
    rothIndex P (fun _ => α) R ≥ t →
    Real.sqrt ((m : ℝ) * ε) ≤ t →
    aeval (fun i => ((q i : ℚ) : ℝ)) P ≠ 0 →
    rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤ t - Real.sqrt ((m : ℝ) * ε)

/-- **REG-1-typed-a-discharge**. -/
theorem T5_REGULUS_v8d5_aeval_q_ne_zero_universal_typed_a_holds :
    T5_REGULUS_v8d5_aeval_q_ne_zero_universal_typed_a :=
  @T5_REGULUS_v8d5_aeval_q_ne_zero_universal

/-! # Section 2 — m = 0 regime UNCONDITIONAL -/

/-! ## REG-2 — m = 0 regime UNCONDITIONAL Type-(a) -/

/-- **REG-2 — `T5_REGULUS_v8d5_m_eq_zero_universal`**: UNCONDITIONAL
    discharge of V8-D5 inequality in the m = 0 regime.

    When m = 0, `Fin 0` is empty, so:
    - The unique multi-index `j : Fin 0 → ℕ` is the empty function
    - `multiIteratedPDeriv j P = P` (no variables to differentiate over)
    - `√(0 * ε) = 0`, target `t - 0 = t`
    - rothIndex set ⊆ Ici 0 (REG-3 lemma) gives sInf ≥ 0

    The V8-D5 conclusion `rothIndex ≤ t` holds when `t ≥ 0`, which is
    automatic from `rothIndex_diag ≥ t` AND `rothIndex_diag ≥ 0`.

    UNCONDITIONAL — m = 0 case is degenerate but well-defined. -/
theorem T5_REGULUS_v8d5_m_eq_zero_universal
    (P : MvPolynomial (Fin 0) ℝ) (R : Fin 0 → ℕ)
    (q : Fin 0 → ℚ) (ε t : ℝ)
    (h_t : 0 ≤ t) :
    rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤ t - Real.sqrt ((0 : ℝ) * ε) := by
  -- Step 1: simplify √(0 * ε) = 0
  have h_zero_sqrt : Real.sqrt ((0 : ℝ) * ε) = 0 := by
    rw [zero_mul, Real.sqrt_zero]
  rw [h_zero_sqrt]
  -- Step 2: rothIndex set in Fin 0 case
  by_cases hP : aeval (fun i => ((q i : ℚ) : ℝ)) P = 0
  · -- aeval = 0: the unique j (empty function) gives multiIteratedPDeriv j P = P
    -- and aeval = 0, so j is NOT in the set; set is empty; sInf ∅ = 0
    have h_set_empty : { r : ℝ | ∃ j : Fin 0 → ℕ,
        aeval (fun i => ((q i : ℚ) : ℝ)) (multiIteratedPDeriv j P) ≠ 0 ∧
        r = ∑ i, (j i : ℝ) / (R i : ℝ) } = ∅ := by
      ext r
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
      rintro ⟨j, hne, _⟩
      have h_id : multiIteratedPDeriv j P = P := by
        unfold multiIteratedPDeriv
        simp [List.finRange_zero]
      rw [h_id] at hne
      exact hne hP
    unfold rothIndex
    rw [h_set_empty]
    rw [Real.sInf_empty]
    linarith
  · -- aeval ≠ 0: rothIndex = 0 by Phase 4 interim master
    push_neg at hP
    have h_zero : rothIndex P (fun i => ((q i : ℚ) : ℝ)) R = 0 :=
      T5_rothIndex_eq_zero_of_aeval_ne_zero P (fun i => ((q i : ℚ) : ℝ)) R hP
    rw [h_zero]
    linarith

/-- **REG-2-typed-a — Type-(a) standalone Prop form**. -/
def T5_REGULUS_v8d5_m_eq_zero_universal_typed_a : Prop :=
  ∀ (P : MvPolynomial (Fin 0) ℝ) (R : Fin 0 → ℕ)
    (q : Fin 0 → ℚ) (ε t : ℝ),
    0 ≤ t →
    rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤ t - Real.sqrt ((0 : ℝ) * ε)

/-- **REG-2-typed-a-discharge**. -/
theorem T5_REGULUS_v8d5_m_eq_zero_universal_typed_a_holds :
    T5_REGULUS_v8d5_m_eq_zero_universal_typed_a :=
  T5_REGULUS_v8d5_m_eq_zero_universal

/-! # Section 3 — Smallness violation contradiction lemmas -/

/-! ## REG-3a — t < √(mε) ⇒ V8-D5 conclusion forces rothIndex < 0 -/

/-- **REG-3a — `T5_REGULUS_v8d5_t_lt_sqrt_implies_index_neg`**: when
    `t < √(mε)`, IF the V8-D5 conclusion holds, THEN rothIndex < 0.

    Documents the structural impossibility of V8-D5 in the smallness-
    violation regime: rothIndex ≥ 0 always (set ⊆ Ici 0 OR sInf ∅ = 0),
    so V8-D5 conclusion `rothIndex ≤ t - √(mε) < 0` requires
    rothIndex < 0, impossible. UNCONDITIONAL — pure structural lemma. -/
theorem T5_REGULUS_v8d5_t_lt_sqrt_implies_index_neg
    {m : ℕ}
    (P : MvPolynomial (Fin m) ℝ) (R : Fin m → ℕ)
    (q : Fin m → ℚ) (ε t : ℝ)
    (h_t_lt : t < Real.sqrt ((m : ℝ) * ε))
    (h_concl : rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤
               t - Real.sqrt ((m : ℝ) * ε)) :
    rothIndex P (fun i => ((q i : ℚ) : ℝ)) R < 0 := by
  have h_neg : t - Real.sqrt ((m : ℝ) * ε) < 0 := by linarith
  linarith [h_concl, h_neg]

/-! ## REG-3b — Combined `aeval q P ≠ 0` AND `t < √(mε)` ⇒ False -/

/-- **REG-3b — `T5_REGULUS_v8d5_t_lt_sqrt_aeval_ne_zero_contradicts`**:
    in the regime `t < √(mε)` AND `aeval q P ≠ 0`, the V8-D5 conclusion
    is structurally impossible.

    Proof: aeval ≠ 0 forces rothIndex = 0 by `T5_rothIndex_eq_zero_of_aeval_ne_zero`.
    Combined with conclusion `rothIndex ≤ t - √(mε) < 0` (from t < √(mε)),
    we get `0 ≤ rothIndex ≤ t - √(mε) < 0`, contradiction.

    UNCONDITIONAL — closes the impossibility branch. -/
theorem T5_REGULUS_v8d5_t_lt_sqrt_aeval_ne_zero_contradicts
    {m : ℕ}
    (P : MvPolynomial (Fin m) ℝ) (R : Fin m → ℕ)
    (q : Fin m → ℚ) (ε t : ℝ)
    (h_aeval : aeval (fun i => ((q i : ℚ) : ℝ)) P ≠ 0)
    (h_t_lt : t < Real.sqrt ((m : ℝ) * ε))
    (h_concl : rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤
               t - Real.sqrt ((m : ℝ) * ε)) :
    False := by
  have h_zero : rothIndex P (fun i => ((q i : ℚ) : ℝ)) R = 0 :=
    T5_rothIndex_eq_zero_of_aeval_ne_zero P (fun i => ((q i : ℚ) : ℝ)) R h_aeval
  have h_neg : t - Real.sqrt ((m : ℝ) * ε) < 0 := by linarith
  linarith [h_concl, h_neg, h_zero]

/-! ## REG-3c — rothIndex ≥ 0 universal lemma (foundational) -/

/-- **REG-3c — `T5_REGULUS_rothIndex_nonneg_universal`**: `rothIndex P α d ≥ 0`
    for ALL `(P, α, d)`. UNCONDITIONAL.

    Either the rothIndex set is empty (`sInf ∅ = 0`) OR nonempty (then
    sInf ≥ 0 by REG-3-style sInf_nonneg with `set ⊆ Ici 0`). Either way,
    rothIndex ≥ 0. -/
theorem T5_REGULUS_rothIndex_nonneg_universal {n : ℕ}
    (P : MvPolynomial (Fin n) ℝ) (α : Fin n → ℝ) (d : Fin n → ℕ) :
    (0 : ℝ) ≤ rothIndex P α d := by
  unfold rothIndex
  by_cases h_emp : { r : ℝ | ∃ j : Fin n → ℕ,
    aeval α (multiIteratedPDeriv j P) ≠ 0 ∧
    r = ∑ i, (j i : ℝ) / (d i : ℝ) } = ∅
  · rw [h_emp, Real.sInf_empty]
  · have h_subset := T5_rothIndex_set_subset_nonneg P α d
    apply Real.sInf_nonneg
    intro r hr
    exact h_subset hr

