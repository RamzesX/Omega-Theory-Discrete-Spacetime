theorem T5_REGULUS_v8d5_schmidt_aux_dominant_regime
    {m : ℕ}
    (P : MvPolynomial (Fin m) ℝ) (R : Fin m → ℕ)
    (q : Fin m → ℚ) (ε t : ℝ)
    (hε : 0 < ε)
    (h_t : Real.sqrt ((m : ℝ) * ε) ≤ t)
    (h_aeval : aeval (fun i => ((q i : ℚ) : ℝ)) P ≠ 0) :
    rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤ t - Real.sqrt ((m : ℝ) * ε) :=
  T5_HEART_lift_unconditional_when_aeval_q_ne_zero P R q ε t hε h_t h_aeval

/-- **REG-4-typed-a — Type-(a) standalone Prop form**. -/
def T5_REGULUS_v8d5_schmidt_aux_dominant_regime_typed_a : Prop :=
  ∀ {m : ℕ} (P : MvPolynomial (Fin m) ℝ) (R : Fin m → ℕ)
    (q : Fin m → ℚ) (ε t : ℝ),
    0 < ε →
    Real.sqrt ((m : ℝ) * ε) ≤ t →
    aeval (fun i => ((q i : ℚ) : ℝ)) P ≠ 0 →
    rothIndex P (fun i => ((q i : ℚ) : ℝ)) R ≤ t - Real.sqrt ((m : ℝ) * ε)

/-- **REG-4-typed-a-discharge**. -/
theorem T5_REGULUS_v8d5_schmidt_aux_dominant_regime_typed_a_holds :
