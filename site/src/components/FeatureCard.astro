---
interface Props {
  title: string;
  description: string;
  icon: string;
  href?: string;
  accent?: 'magenta' | 'azure' | 'amber' | 'jade' | 'rose';
}

const { title, description, icon, href, accent = 'magenta' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['feature-card', `accent-${accent}`]} href={href}>
  <span class="card-icon" aria-hidden="true">{icon}</span>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>
  </div>
  {href && (
    <span class="card-arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </span>
  )}
</Tag>

<style>
  .feature-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-vellum);
    border: 1px solid var(--color-seam);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: transform var(--t-normal), border-color var(--t-fast), box-shadow var(--t-normal);
    align-items: flex-start;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(200, 110, 255, 0.08), transparent 45%);
    opacity: 0;
    transition: opacity var(--t-normal);
    pointer-events: none;
  }

  a.feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-color, var(--color-magenta));
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.4),
                0 0 30px rgba(200, 110, 255, 0.18);
    text-decoration: none;
  }

  a.feature-card:hover::before { opacity: 1; }

  .card-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    border-radius: var(--radius-md);
    background: var(--color-ink);
    border: 1px solid var(--color-seam);
    color: var(--accent-color, var(--color-magenta));
  }

  .card-body { flex: 1; min-width: 0; }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .card-description {
    font-size: 0.9rem;
    color: var(--color-text-dim);
    line-height: 1.55;
    margin: 0;
    max-width: none;
  }

  .card-arrow {
    flex-shrink: 0;
    color: var(--color-text-mut);
    transition: color var(--t-fast), transform var(--t-fast);
    margin-top: 8px;
  }

  a.feature-card:hover .card-arrow {
    color: var(--accent-color, var(--color-magenta));
    transform: translateX(3px);
  }

  /* Accent variants set the CSS variable */
  .feature-card.accent-magenta { --accent-color: var(--color-magenta); }
  .feature-card.accent-azure   { --accent-color: var(--color-azure); }
  .feature-card.accent-amber   { --accent-color: var(--color-amber); }
  .feature-card.accent-jade    { --accent-color: var(--color-jade); }
  .feature-card.accent-rose    { --accent-color: var(--color-rose); }
</style>
