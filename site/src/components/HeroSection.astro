---
const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<section class="hero">
  <div class="hero-left">
    <div class="hero-badge">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span>Lean 4 verified · 0 sorry · 8 physical axioms</span>
    </div>

    <h1 class="hero-title">
      <span class="omega" aria-hidden="true">Ω</span><span class="title-rest">mega-Theory</span>
    </h1>

    <p class="hero-subtitle">
      Mass as geometric reshaping of a discrete&nbsp;ℤ⁴ Planck lattice.
    </p>

    <p class="hero-description">
      From a single postulate and three irrational constants
      (<span class="irr pi">π</span>, <span class="irr e"><em>e</em></span>,
      <span class="irr s2">√2</span>) we derive the Standard&nbsp;Model mass
      hierarchy, CKM/PMNS mixing, Higgs sector, gravitational dynamics, and
      cosmological parameters. <strong>Every claim is machine-verified.</strong>
    </p>

    <div class="hero-cta">
      <a href={`${baseUrl}cycles/`} class="btn btn-primary">
        <span>See 14 cycles · 84 predictions</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>
      <a href={`${baseUrl}papers/main-paper-postulates/`} class="btn btn-outline">
        Read the paper
      </a>
    </div>
  </div>

  <figure class="hero-visual" aria-hidden="true">
    <svg viewBox="0 0 320 320" class="lattice-svg">
      <defs>
        <radialGradient id="h-pi" cx="50%" cy="50%">
          <stop offset="0" stop-color="#ff6b88" stop-opacity="0.85"/>
          <stop offset="1" stop-color="#ff6b88" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="h-e" cx="50%" cy="50%">
          <stop offset="0" stop-color="#f5a623" stop-opacity="0.85"/>
          <stop offset="1" stop-color="#f5a623" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="h-s2" cx="50%" cy="50%">
          <stop offset="0" stop-color="#4fd99a" stop-opacity="0.85"/>
          <stop offset="1" stop-color="#4fd99a" stop-opacity="0"/>
        </radialGradient>
        <linearGradient id="grid-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#c86eff" stop-opacity="0.25"/>
          <stop offset="1" stop-color="#5fb8ff" stop-opacity="0.08"/>
        </linearGradient>
      </defs>

      <!-- ℤ⁴ lattice projection (dots) -->
      <g fill="url(#grid-grad)" stroke="none">
        {Array.from({ length: 9 }).map((_, i) =>
          Array.from({ length: 9 }).map((_, j) => (
            <circle
              cx={40 + i * 30}
              cy={40 + j * 30}
              r={((i + j) % 3 === 0) ? 1.4 : 0.7}
            />
          ))
        )}
      </g>

      <!-- Connection lines forming rhombus hint of ℤ⁴ -->
      <g stroke="#5fb8ff" stroke-opacity="0.12" stroke-width="0.5" fill="none">
        <path d="M 40 160 L 160 40 L 280 160 L 160 280 Z"/>
        <path d="M 100 100 L 220 100 L 220 220 L 100 220 Z"/>
      </g>

      <!-- Three generation "channels" -->
      <circle cx="110" cy="130" r="58" fill="url(#h-pi)" opacity="0.7"/>
      <circle cx="210" cy="130" r="48" fill="url(#h-e)" opacity="0.7"/>
      <circle cx="160" cy="210" r="40" fill="url(#h-s2)" opacity="0.7"/>

      <g font-family="var(--font-display), serif" font-weight="700" text-anchor="middle">
        <text x="110" y="136" font-size="36" fill="#fff" font-style="italic">π</text>
        <text x="210" y="136" font-size="30" fill="#fff" font-style="italic">e</text>
        <text x="160" y="216" font-size="22" fill="#fff">√2</text>
      </g>

      <g font-family="var(--font-mono), monospace" font-size="9" fill="#b4bacb" text-anchor="middle">
        <text x="110" y="90">gen 3 · heavy</text>
        <text x="210" y="90">gen 2 · middle</text>
        <text x="160" y="256">gen 1 · light</text>
      </g>
    </svg>
    <figcaption class="lattice-caption">
      <span>Three irrationals → three generations.</span>
      <span class="caption-formula">
        δ<sub>comp</sub>(N) = ℓ<sub>P</sub> · 4/(2N+3) · 3/(N+1)! · 2<sup>−2ᴺ</sup>
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-2xl);
    padding: var(--space-xl) 0 var(--space-2xl);
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 4px 12px 4px 10px;
    background: rgba(79, 217, 154, 0.10);
    border: 1px solid rgba(79, 217, 154, 0.30);
    border-radius: var(--radius-pill);
    font-size: 0.74rem;
    font-weight: 500;
    font-family: var(--font-mono);
    color: var(--color-jade);
    margin-bottom: var(--space-md);
    letter-spacing: 0.02em;
  }

  .pulse-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--color-jade);
    box-shadow: 0 0 8px var(--color-jade);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    font-weight: 700;
    line-height: 0.95;
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    display: flex;
    align-items: baseline;
    letter-spacing: -0.035em;
  }

  .omega {
    font-size: 1.15em;
    font-weight: 800;
    font-style: italic;
    background: var(--grad-magenta-azure);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    filter: drop-shadow(0 0 18px rgba(200, 110, 255, 0.35));
  }

  .title-rest { color: var(--color-text); }

  .hero-subtitle {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    color: var(--color-text-dim);
    margin: 0 0 var(--space-lg);
    font-style: italic;
    line-height: 1.45;
    max-width: 34rem;
  }

  .hero-description {
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--color-text-dim);
    margin-bottom: var(--space-xl);
    max-width: 34rem;
  }

  .irr {
    font-family: var(--font-display);
    font-weight: 600;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-seam);
  }
  .irr.pi { color: var(--color-rose); }
  .irr.e  { color: var(--color-amber); font-style: italic; }
  .irr.s2 { color: var(--color-jade); }
  .irr em { font-style: italic; color: inherit; }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Right side visual */
  .hero-visual {
    margin: 0;
    padding: var(--space-lg);
    background: linear-gradient(160deg, rgba(200, 110, 255, 0.06), rgba(95, 184, 255, 0.03));
    border: 1px solid var(--color-seam);
    border-radius: var(--radius-xl);
    box-shadow: inset 0 0 60px rgba(200, 110, 255, 0.05),
                0 12px 40px rgba(7, 9, 15, 0.4);
  }

  .lattice-svg {
    width: 100%;
    max-width: 320px;
    display: block;
    margin: 0 auto;
  }

  .lattice-caption {
    text-align: center;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-seam);
    margin-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .lattice-caption > span:first-child {
    font-size: 0.78rem;
    color: var(--color-text-dim);
    letter-spacing: 0.02em;
  }

  .caption-formula {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-mut);
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .hero-visual { max-width: 320px; margin: 0 auto; }
  }
</style>
