---
interface Props {
  type: 'theorem' | 'proof' | 'definition' | 'postulate' | 'equation';
  title?: string;
  number?: string;
}

const { type, title, number } = Astro.props;

const glyphs: Record<string, string> = {
  theorem: '▣',
  proof: '∎',
  definition: '§',
  postulate: '◇',
  equation: '∫',
};

const defaultTitles: Record<string, string> = {
  theorem: 'Theorem',
  proof: 'Proof',
  definition: 'Definition',
  postulate: 'Postulate',
  equation: 'Key Equation',
};
---

<div class={`box box-${type}`}>
  <div class="box-title">
    <span class="box-icon" aria-hidden="true">{glyphs[type]}</span>
    <span>{title || defaultTitles[type]}{number ? ` · ${number}` : ''}</span>
  </div>
  <div class="box-content">
    <slot />
  </div>
</div>

<style>
  .box-icon {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1;
    color: inherit;
  }

  .box-postulate .box-icon { transform: rotate(12deg); display: inline-block; }
</style>
