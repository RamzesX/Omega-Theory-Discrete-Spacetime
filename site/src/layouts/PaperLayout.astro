---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
  title: string;
  description?: string;
  date?: string;
  readingTime?: string;
  category?: string;
}

const { title, description, date, readingTime, category } = Astro.props;
// See BaseLayout.astro — always end with `/` so href/src concat is safe.
const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<BaseLayout title={title} description={description}>
  <Navigation slot="sidebar" />

  <article class="paper">
    <header class="paper-header">
      {category && <span class="paper-category eyebrow">{category}</span>}
      <h1 class="paper-title">{title}</h1>
      {description && <p class="paper-description">{description}</p>}
      <div class="paper-meta">
        {date && (
          <span class="meta-item">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2.5" y="3.5" width="11" height="10" rx="1"/>
              <line x1="2.5" y1="6" x2="13.5" y2="6"/>
              <line x1="5" y1="2" x2="5" y2="5"/>
              <line x1="11" y1="2" x2="11" y2="5"/>
            </svg>
            {date}
          </span>
        )}
        {readingTime && (
          <span class="meta-item">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="8" cy="8" r="6"/>
              <path d="M8 4v4l2.5 2.5"/>
            </svg>
            {readingTime} read
          </span>
        )}
      </div>
    </header>

    <div class="paper-content">
      <slot />
    </div>

    <footer class="paper-footer">
      <a href={baseUrl} class="back-link">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4"/>
        </svg>
        Back to overview
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .paper {
    /* 46rem (736px) was too tight for ASCII diagrams + wide tables.
       54rem felt cramped still with 6-column reference tables.
       60rem (960px) is the classic physics-paper column width — prose line
       length around 100 chars (upper-readable, but fine for dense physics
       content) and gives tables/diagrams enough room. */
    max-width: 60rem;
    margin: 0 auto;
  }

  .paper-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-seam);
  }

  .paper-category {
    color: var(--color-magenta);
    margin-bottom: var(--space-sm);
  }

  .paper-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    margin: 0 0 var(--space-sm);
    color: var(--color-text);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .paper-description {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-text-dim);
    line-height: 1.55;
    margin-bottom: var(--space-md);
    font-style: italic;
    max-width: 42rem;
  }

  .paper-meta {
    display: flex;
    gap: var(--space-lg);
    color: var(--color-text-mut);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .paper-content {
    line-height: 1.75;
    font-size: 1.02rem;
    color: var(--color-text-dim);
  }

  .paper-content :global(p) {
    max-width: none;
    margin-bottom: var(--space-md);
  }

  .paper-content :global(h2) {
    margin-top: var(--space-2xl);
    font-size: 1.6rem;
    border-bottom: 1px solid var(--color-seam);
    padding-bottom: var(--space-xs);
    color: var(--color-text);
  }

  .paper-content :global(h3) {
    margin-top: var(--space-xl);
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .paper-content :global(h4) {
    margin-top: var(--space-lg);
    font-size: 1.075rem;
    color: var(--color-text);
  }

  .paper-content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: var(--space-lg) 0;
    border: 1px solid var(--color-seam);
  }

  .paper-content :global(.katex-display) {
    overflow-x: auto;
    padding: var(--space-md) var(--space-lg);
  }

  /* ASCII diagrams + wide code / tables break out of the 54rem prose column
     — they get the full paper-content width (bounded only by the parent
     main-content, which leaves ~800-900px of usable width on desktop).
     For code-fence <pre> with Shiki syntax highlighting this is fine —
     long code lines still scroll horizontally inside the pre. */
  .paper-content :global(pre),
  .paper-content :global(table) {
    max-width: calc(100% + var(--space-xl) * 2);
    margin-left: calc(-1 * var(--space-md));
    margin-right: calc(-1 * var(--space-md));
  }
  @media (max-width: 900px) {
    .paper-content :global(pre),
    .paper-content :global(table) {
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
    }
  }
  /* ASCII art pre (no Shiki language class): smaller font + no syntax
     background so it reads as a diagram, not code. */
  .paper-content :global(pre:not([class*="language-"]):not(.astro-code)) {
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .paper-content :global(figure) {
    margin: var(--space-xl) 0;
  }

  .paper-content :global(figcaption) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-mut);
    text-align: center;
    margin-top: var(--space-xs);
  }

  .paper-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-seam);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text-mut);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: color var(--t-fast);
    border-bottom: 0;
  }

  .back-link:hover {
    color: var(--color-magenta);
    border-bottom: 0;
  }

  @media (max-width: 768px) {
    .paper-title { font-size: 1.75rem; }
    .paper-description { font-size: 1rem; }
    .paper-meta { flex-direction: column; gap: var(--space-xs); }
  }
</style>
