---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import { HEADLINES } from '../data/status.mjs';

const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<BaseLayout title="404 · Worldline lost" description="The requested page does not exist in our ℤ⁴ lattice.">
  <Navigation slot="sidebar" />

  <div class="fourofour">
    <div class="singularity">
      <div class="code">404</div>
      <div class="lattice-grid" aria-hidden="true">
        {Array.from({ length: 64 }).map((_, i) => <span class="dot" style={`--n:${i}`}></span>)}
      </div>
    </div>

    <h1 class="title">Worldline not in the lattice</h1>

    <p class="lead">
      The requested coordinate has no corresponding vertex in our ℤ⁴ Planck lattice.
      Either the URL truncated below resolution, or the page recently decayed into
      an off-shell fluctuation.
    </p>

    <div class="equation-card">
      <span class="eq-label">No event at</span>
      <div class="eq-body mono"><span id="requested-path">/…</span></div>
      <span class="eq-help">
        If you arrived via a link, please
        <a href="https://github.com/RamzesX/chaos-shield/issues/new" target="_blank" rel="noopener">file an issue</a>.
      </span>
    </div>

    <div class="suggestions">
      <a href={baseUrl} class="btn btn-primary">
        <span>Return to origin</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4"/>
        </svg>
      </a>
      <a href={`${baseUrl}cycles/`} class="btn btn-outline">Browse the {HEADLINES.cyclesShipped} cycles</a>
      <a href={`${baseUrl}papers/main-paper-postulates/`} class="btn btn-outline">Read the main paper</a>
    </div>

    <p class="footnote mono">
      <span>status: <span class="text-amber">Planck-scale truncation error</span></span>
      <span>δ<sub>comp</sub>(N→∞) = 0</span>
    </p>
  </div>
</BaseLayout>

<script is:inline>
  // Show the path the user tried to reach. Defensive: 404 pages on GitHub Pages
  // sometimes receive the full path as query.
  try {
    const el = document.getElementById('requested-path');
    if (el) {
      const p = location.pathname + location.search + location.hash;
      el.textContent = p.length > 64 ? p.slice(0, 61) + '…' : p;
    }
  } catch (_) {}
</script>

<style>
  .fourofour {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-xl) var(--space-md) var(--space-3xl);
  }

  .singularity {
    position: relative;
    margin: 0 auto var(--space-xl);
    width: 240px;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .code {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 6.5rem;
    font-weight: 800;
    line-height: 1;
    background: var(--grad-amber-magenta);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 30px rgba(245, 166, 35, 0.3));
    letter-spacing: -0.04em;
  }

  .lattice-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 4px;
    pointer-events: none;
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-seam);
    justify-self: center;
    align-self: center;
    opacity: 0.6;
    animation: dot-fade 4s ease-in-out infinite;
    animation-delay: calc(var(--n) * 50ms);
  }

  @keyframes dot-fade {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50% { opacity: 0.9; transform: scale(1.2); background: var(--color-magenta); }
  }

  .title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 700;
    margin: 0 0 var(--space-md);
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: 1rem;
    color: var(--color-text-dim);
    margin: 0 auto var(--space-xl);
    max-width: 38rem;
    line-height: 1.65;
  }

  .equation-card {
    display: inline-flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-vellum);
    border: 1px solid var(--color-seam);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-xl);
    min-width: 18rem;
  }

  .eq-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-mut);
    font-family: var(--font-mono);
  }

  .eq-body {
    color: var(--color-amber);
    font-size: 1rem;
    word-break: break-all;
  }

  .eq-help {
    font-size: 0.78rem;
    color: var(--color-text-mut);
  }

  .suggestions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-2xl);
  }

  .footnote {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    font-size: 0.7rem;
    color: var(--color-text-mut);
    letter-spacing: 0.04em;
    flex-wrap: wrap;
  }
</style>
