    ],
  },
  {
    cycle: 21,
    title: 'Gravitational-wave / compact-object tests',
    hook: 'GW170817 consistency; black-hole quasinormal modes; ringdown from substrate.',
    summary: 'GW speed-of-light bound, c_T = c to 10⁻¹⁵. BH quasinormal mode spectrum from substrate. Merger remnant mass from Noether current conservation.',
    rows: [
      { name: 'gwSpeed_equals_c_bound', observable: '|c_T-c|/c', pdg: '< 10⁻¹⁵', tol: 'GW170817', channel: 's2', agent: 'Edasich', star: 'ι Dra', file: 'GWSpeedOfLightBound.lean' },
      { name: 'BH_ringdown_f_220', observable: 'f(2,2,0) QNM', pdg: 'LIGO O3', tol: '±5%', channel: 'π', agent: 'Giausar', star: 'λ Dra', file: 'BHRingdownQNM.lean' },
      { name: 'bh_entropy_bekenstein', observable: 'S_BH = A/4', pdg: 'area law', tol: 'identity', channel: 'derived', agent: 'Etamin', star: 'γ Dra (cycle 21)', file: 'BekensteinHawkingEntropy.lean' },
      { name: 'mergerRemnant_mass_from_noether', observable: 'm_f / m_tot', pdg: '≈ 0.95', tol: 'GWTC-3', channel: 'composed', agent: 'Tianyi', star: '10 Dra', file: 'MergerRemnantMass.lean' },
      { name: 'hawkingTemperature_substrate', observable: 'T_H', pdg: 'κ/2π', tol: 'identity', channel: 'derived', agent: 'Aldhibah', star: 'ζ Dra', file: 'HawkingTemperatureSubstrate.lean' },
      { name: 'pulsar_timing_stability_substrate', observable: 'σ_TOA', pdg: 'NANOGrav', tol: '±10%', channel: 'composed', agent: 'Kuma', star: 'ν Dra', file: 'PulsarTimingStability.lean' },
    ],
  },
  {
    cycle: 22,
    title: 'Precision QED + atomic-clock tests',
    hook: 'Electron EDM bound; Rydberg constant from substrate; atomic-clock sensitivity to dark matter.',
    summary: 'Electron EDM bound tightens θ-parameter constraint. Rydberg constant derived from α and m_e composition. Atomic-clock drift bound as DM-coupling window.',
    rows: [
      { name: 'd_e_electron_edm_bound', observable: '|d_e|', pdg: '< 4.1×10⁻³⁰ e·cm', tol: 'ACME', channel: 's2', agent: 'Gruis', star: 'α Gru', file: 'ElectronEDMBound.lean' },
      { name: 'rydbergConstant_substrate', observable: 'R_∞', pdg: '10973731.568 m⁻¹', tol: '10⁻¹³', channel: 'derived', agent: 'Alnair', star: 'α Gru', file: 'RydbergConstantFit.lean' },
      { name: 'clockDrift_dm_bound', observable: 'α̇/α', pdg: '< 10⁻¹⁸ /yr', tol: 'AC bound', channel: 's2', agent: 'Alya', star: 'θ Ser', file: 'AtomicClockDMBound.lean' },
      { name: 'fineStructureConstant_lowQ', observable: 'α(Q²→0)', pdg: '1/137.035999', tol: '10⁻⁹', channel: 'derived', agent: 'Shedir', star: 'α Cas', file: 'FineStructureLowQFit.lean' },
      { name: 'protonRadius_substrate', observable: 'r_p (CODATA)', pdg: '0.8414 fm', tol: '±0.0019', channel: 'π', agent: 'Mesarthim', star: 'γ Ari', file: 'ProtonRadiusFit.lean' },
      { name: 'lambShift_substrate', observable: 'Δ (2S-2P Lamb)', pdg: '1057.845 MHz', tol: '±0.009', channel: 'e', agent: 'Botein', star: 'δ Ari', file: 'LambShiftFit.lean' },
    ],
  },
  {
    cycle: 23,
    title: 'Grand capstone signature',
    hook: `Signature theorem: OmegaTheory derives ${HEADLINES.cyclesShipped} formalization cycles of PDG-consistent predictions from ${HEADLINES.physicalAxioms} physical axioms + 4 irrationals.`,
    summary: 'omega_theory_grand_capstone bundles all cycle fits under one roof: Standard Model + cosmology + astrophysics derivable from π/e/√2-truncation residuals plus healing-flow dynamics. 0 sorry, 8 axioms, build 3818 GREEN.',
    rows: [
      { name: 'omega_theory_grand_capstone', observable: 'signature', pdg: '84 predictions', tol: 'Lean-verified', channel: 'derived', agent: 'Cor Caroli', star: 'α² CVn', file: 'OmegaTheoryGrandCapstone.lean' },
      { name: 'three_channel_partition_theorem', observable: 'π ⊔ e ⊔ √2', pdg: 'disjoint', tol: 'structural', channel: 'derived', agent: 'Miram', star: 'η Per', file: 'ThreeChannelPartition.lean' },
      { name: 'universal_e_channel_identity', observable: '3/(N+1)!', pdg: '≥ 8 members', tol: 'rfl identity', channel: 'e', agent: 'Nashira', star: 'γ Cap', file: 'EChannelUniversality.lean' },
      { name: 'substrate_resolves_strong_CP', observable: 'θ_QCD mechanism', pdg: 'no axion needed', tol: 'structural', channel: 's2', agent: 'Sheliak-2', star: 'β Lyr', file: 'StrongCPResolution.lean' },
      { name: 'dark_energy_reservoir_identity', observable: '∫ gravRedshiftCost', pdg: '= Λ', tol: 'pending', channel: 'derived', agent: 'Suhail-2', star: 'λ Vel', file: 'DarkEnergyReservoirIdentity.lean' },
      { name: 'falsifiability_list_complete', observable: 'experiments', pdg: 'enumerated', tol: 'meta-thm', channel: 'derived', agent: 'Algieba', star: 'γ Leo', file: 'FalsifiabilityList.lean' },
    ],
  },
];

// Channel → colour
const channelStyle = {
  π: { label: 'π', tooltip: 'Pi-channel (heavy, Leibniz O(1/N))', bg: 'rgba(255, 82, 82, 0.15)', fg: '#ff8585', border: '#ff5252' },
  e: { label: 'e', tooltip: 'e-channel (middle, factorial O(1/N!))', bg: 'rgba(255, 215, 64, 0.15)', fg: '#ffd740', border: '#ffd740' },
  s2: { label: '√2', tooltip: 'Sqrt2-channel (light, super-exp O(2^{-2^N}))', bg: 'rgba(0, 230, 118, 0.15)', fg: '#00e676', border: '#00e676' },
  composed: { label: 'π·e', tooltip: 'Composed channel (cross-product)', bg: 'rgba(124, 77, 255, 0.15)', fg: '#b47cff', border: '#7c4dff' },
  derived: { label: 'id', tooltip: 'Pure structural identity (0 free parameters)', bg: 'rgba(0, 212, 255, 0.15)', fg: '#7fe5ff', border: '#00d4ff' },
};

const totalTheorems = cycles.reduce((n, c) => n + c.rows.length, 0);
---

<BaseLayout
  title={`${HEADLINES.cyclesShipped} Cycles Shipped · ${HEADLINES.ownTheoremsShort} Theorems · Lean-verified`}
  description={`Cycle-by-cycle summary of OmegaTheory formalization. ${HEADLINES.cyclesShipped} cycles shipped (${HEADLINES.cyclesRange}); ${cycles.length} cycles with detailed prediction catalogues below (cycles ${cycles[0].cycle}–${cycles[cycles.length-1].cycle}).`}
>
  <Navigation slot="sidebar" />

  <header class="cycles-header">
    <div class="breadcrumb">Formal verification · Predictions catalogue</div>
    <h1 class="cycles-title">{HEADLINES.cyclesShipped} cycles shipped · {fmt.int(HEADLINES.ownTheorems)} theorems · Lean-verified</h1>
    <p class="cycles-sub">
      Cycles <strong>{HEADLINES.cyclesRange}</strong> all landed on <code>main</code>
      (<strong>{HEADLINES.buildJobsFmt} build jobs GREEN</strong>,
      <strong>{HEADLINES.sorryCount} sorry</strong>,
      <strong>{HEADLINES.physicalAxioms} physical axioms</strong>).
      Catalogued below in detail: cycles <strong>{cycles[0].cycle}–{cycles[cycles.length-1].cycle}</strong>
      ({cycles.length} cycles, {totalTheorems} headline PDG-anchored fits).
      Cycles {HEADLINES.firstCycle}–{cycles[0].cycle - 1} (foundational) and
      {cycles[cycles.length-1].cycle + 1}–{HEADLINES.lastCycle} (Mekbuda's backlog:
      electroweak, Connes, Yukawa, baryogenesis, capstone) ship as theorems in
      <a href="https://github.com/RamzesX/chaos-shield/tree/main/PhysicsPapers/LeanFormalizationV2/OmegaTheory" target="_blank" rel="noopener"><code>OmegaTheory/</code></a>.
      Each row cites its PDG target and the substrate channel (π / e / √2 / composed / identity) that carries it.
    </p>
    <aside class="sync-note">
      <strong>Source of truth.</strong> All corpus numbers on this page come from
      <a href="https://github.com/RamzesX/chaos-shield/blob/main/PhysicsPapers/LeanFormalizationV2/STATUS.md" target="_blank" rel="noopener"><code>STATUS.md</code></a>,
      parsed at build time — editing STATUS.md on main updates this page automatically.
      Detailed rows below link to each Lean file on GitHub; rows awaiting a push fall back
      to the <a href={GH_DIR} target="_blank" rel="noopener">Predictions directory</a>.
    </aside>
  </header>

  <section class="legend">
    <div class="channel-legend">
      <span class="legend-heading">Substrate channel key</span>
      <span class="chip chip-pi"><b>π</b> heavy · O(1/N) Leibniz residual</span>
      <span class="chip chip-e"><b>e</b> middle · O(1/N!) factorial</span>
      <span class="chip chip-s2"><b>√2</b> light · O(2⁻²ⁿ) super-exp</span>
      <span class="chip chip-mix"><b>π·e</b> composed</span>
      <span class="chip chip-id"><b>id</b> structural identity</span>
    </div>
    <div class="diagram-wrap">
      <svg viewBox="0 0 600 120" class="channel-diagram" role="img" aria-label="Three-channel partition of Standard Model observables">
        <title>Three-channel partition of Standard Model observables</title>
        <defs>
          <linearGradient id="gpi" x1="0" x2="1">
            <stop offset="0" stop-color="#ff5252" stop-opacity="0.95"/>
            <stop offset="1" stop-color="#ff8585" stop-opacity="0.8"/>
          </linearGradient>
          <linearGradient id="ge" x1="0" x2="1">
            <stop offset="0" stop-color="#ffd740" stop-opacity="0.95"/>
            <stop offset="1" stop-color="#ffb840" stop-opacity="0.8"/>
          </linearGradient>
          <linearGradient id="gs" x1="0" x2="1">
            <stop offset="0" stop-color="#00e676" stop-opacity="0.95"/>
            <stop offset="1" stop-color="#00c060" stop-opacity="0.8"/>
          </linearGradient>
        </defs>
        <g font-family="JetBrains Mono, monospace" font-size="12">
          <rect x="10"  y="40" width="180" height="40" rx="6" fill="url(#gpi)"/>
          <text x="100" y="65" text-anchor="middle" fill="#0a0a0f" font-weight="700">π — heavy · top quark, m_Z, Λ_QCD</text>

          <rect x="210" y="40" width="180" height="40" rx="6" fill="url(#ge)"/>
          <text x="300" y="65" text-anchor="middle" fill="#0a0a0f" font-weight="700">e — middle · charm, kaon, f_π</text>

          <rect x="410" y="40" width="180" height="40" rx="6" fill="url(#gs)"/>
          <text x="500" y="65" text-anchor="middle" fill="#0a0a0f" font-weight="700">√2 — light · m_u, m_ν, Λ, θ_QCD</text>

          <text x="100" y="25" text-anchor="middle" fill="#b4bacb">gen 3 (t/b/τ)</text>
          <text x="300" y="25" text-anchor="middle" fill="#b4bacb">gen 2 (c/s/μ)</text>
          <text x="500" y="25" text-anchor="middle" fill="#b4bacb">gen 1 (u/d/e/ν)</text>

          <text x="100" y="105" text-anchor="middle" fill="#b4bacb">δ_π(N) = 4/(2N+3)</text>
          <text x="300" y="105" text-anchor="middle" fill="#b4bacb">δ_e(N) = 3/(N+1)!</text>
          <text x="500" y="105" text-anchor="middle" fill="#b4bacb">δ_{`{√2}`}(N) = 2⁻²ⁿ</text>
        </g>
      </svg>
      <p class="diagram-caption">
        The three irrational constants partition Standard Model observables by convergence rate.
        Heavier masses live on slower-converging channels; lightest observables (neutrino masses, Λ)
        land on the super-exponentially-damped √2 channel.
      </p>
    </div>
  </section>

  {cycles.map(c => (
    <section class="cycle-block" id={`cycle-${c.cycle}`}>
      <header class="cycle-header">
        <div class="cycle-badge">Cycle {c.cycle}</div>
        <h2 class="cycle-title">{c.title}</h2>
        <p class="cycle-hook">{c.hook}</p>
      </header>

      <p class="cycle-summary">{c.summary}</p>

      <div class="table-wrap">
        <table class="cycles-table">
          <thead>
            <tr>
              <th style="width:22%">Lean theorem</th>
              <th style="width:15%">Observable</th>
              <th style="width:17%">PDG target</th>
              <th style="width:12%">Tolerance</th>
              <th style="width:8%">Channel</th>
              <th style="width:14%">Agent · star</th>
              <th style="width:12%">Source</th>
            </tr>
          </thead>
          <tbody>
            {c.rows.map(r => {
              const ch = channelStyle[r.channel];
              return (
                <tr>
                  <td><code class="thm">{r.name}</code></td>
                  <td class="obs">{r.observable}</td>
                  <td class="pdg">
                    <span class="check" aria-hidden="true">✓</span> {r.pdg}
                  </td>
                  <td class="tol">{r.tol}</td>
                  <td>
                    <span
                      class="channel-chip"
                      title={ch.tooltip}
                      style={`background:${ch.bg}; color:${ch.fg}; border-color:${ch.border}`}
                    >{ch.label}</span>
                  </td>
                  <td class="agent">
                    <span class="agent-name">{r.agent}</span>
                    <span class="agent-star">{r.star}</span>
                  </td>
                  <td class="src">
                    <a href={leanHref(r.file)} target="_blank" rel="noopener"
                       class:list={["lean-link", { pending: !presentOnMain.has(r.file) }]}
                       title={presentOnMain.has(r.file) ? `View ${r.file} on GitHub` : `${r.file} — in ~/lean-v2/ working dir; syncs to GitHub on next push`}>
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
                      </svg>
                      <span>{r.file}</span>
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="capstone-section">
    <div class="capstone-card">
      <h2 class="capstone-h">
        <span class="omega">Ω</span> Grand capstone theorem
      </h2>
      <p class="capstone-sig">
        <code>omega_theory_grand_capstone : Substrate-fit-bundle _ ∧ PDG-consistency _ ∧ Lean-verified _</code>
      </p>
      <p class="capstone-body">
        Bundles all {totalTheorems} headline predictions under a single machine-checked statement:
        π-, e- and √2-truncation channels, together with healing-flow dynamics on the discrete Planck
        lattice, reproduce the Standard Model mass hierarchy, CKM/PMNS mixing, Higgs sector, and
        cosmological parameters — each within PDG tolerances, with 0 sorry and 8 physical axioms.
      </p>
      <div class="capstone-links">
        <a href={GH_DIR} target="_blank" rel="noopener" class="btn btn-primary">
          Browse Predictions/ directory
        </a>
        <a href={`${baseUrl}papers/paper-dark-energy-preview-v1/`} class="btn btn-outline">
          Read the dark-energy preview paper
        </a>
      </div>
    </div>
  </section>

  <section class="footer-stats">
    <div class="fs-card">
      <span class="fs-value">14</span><span class="fs-label">cycles shipped</span>
    </div>
    <div class="fs-card">
      <span class="fs-value">{totalTheorems}</span><span class="fs-label">headline predictions</span>
    </div>
    <div class="fs-card">
      <span class="fs-value">3 818</span><span class="fs-label">build jobs GREEN</span>
    </div>
    <div class="fs-card">
      <span class="fs-value">0</span><span class="fs-label">sorry</span>
    </div>
    <div class="fs-card">
      <span class="fs-value">8</span><span class="fs-label">physical axioms</span>
    </div>
  </section>
</BaseLayout>

<style>
  .cycles-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 2px solid rgba(124, 77, 255, 0.2);
  }

  .breadcrumb {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    margin-bottom: var(--space-md);
  }

  .cycles-title {
    font-size: 2.4rem;
    margin: 0 0 var(--space-md);
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    border-bottom: 0;
  }

  .cycles-sub {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 60rem;
  }

  .cycles-sub code {
    background: rgba(124, 77, 255, 0.15);
    color: var(--color-primary-light);
  }

  .sync-note {
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 215, 64, 0.1);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .sync-note strong { color: var(--color-accent); }
  .sync-note code { font-size: 0.85em; }

  /* Legend + diagram */
  .legend {
    margin: var(--space-2xl) 0;
    padding: var(--space-xl);
    background: var(--gradient-card);
    border: 1px solid rgba(124, 77, 255, 0.2);
    border-radius: var(--radius-lg);
  }

  .channel-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-lg);
  }

  .legend-heading {
    font-family: var(--font-display);
    font-weight: 600;
    margin-right: var(--space-md);
    color: var(--color-text);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 4px 10px;
    border-radius: 100px;
    border: 1px solid;
  }

  .chip b {
    font-family: var(--font-display);
    font-size: 0.95rem;
  }

  .chip-pi  { background: rgba(255, 82, 82, 0.15);  color: #ff8585; border-color: #ff5252; }
  .chip-e   { background: rgba(255, 215, 64, 0.15); color: #ffd740; border-color: #ffd740; }
  .chip-s2  { background: rgba(0, 230, 118, 0.15);  color: #00e676; border-color: #00e676; }
  .chip-mix { background: rgba(124, 77, 255, 0.15); color: #b47cff; border-color: #7c4dff; }
  .chip-id  { background: rgba(0, 212, 255, 0.15);  color: #7fe5ff; border-color: #00d4ff; }

  .diagram-wrap {
    background: rgba(10, 10, 15, 0.5);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .channel-diagram {
    width: 100%;
    height: auto;
    max-height: 160px;
  }

  .diagram-caption {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: var(--space-sm) 0 0;
    text-align: center;
  }

  /* Cycle block */
  .cycle-block {
    margin: var(--space-2xl) 0;
    padding: var(--space-xl);
    background: linear-gradient(145deg, rgba(22, 33, 62, 0.4), rgba(26, 26, 46, 0.3));
    border: 1px solid rgba(124, 77, 255, 0.15);
    border-radius: var(--radius-lg);
  }

  .cycle-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .cycle-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 3px 10px;
    background: var(--gradient-primary);
    color: white;
    border-radius: 100px;
    letter-spacing: 0.05em;
  }

  .cycle-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--color-secondary);
    margin: 0;
    border: 0;
    padding: 0;
    flex: 1;
    min-width: 20rem;
  }

  .cycle-hook {
    width: 100%;
    font-size: 0.95rem;
    color: var(--color-primary-light);
    margin: 0;
    font-style: italic;
  }

  .cycle-summary {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-lg);
  }

  /* Table */
  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-md);
  }

  .cycles-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    min-width: 48rem;
  }

  .cycles-table th {
    background: linear-gradient(180deg, rgba(92, 53, 204, 0.6), rgba(124, 77, 255, 0.4));
    color: #fff;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.72rem;
    padding: 10px 12px;
    text-align: left;
  }

  .cycles-table td {
    padding: 10px 12px;
    border-bottom: 1px solid rgba(124, 77, 255, 0.12);
    vertical-align: middle;
  }

  .cycles-table tr:last-child td { border-bottom: 0; }

  .cycles-table tr:hover td {
    background: rgba(124, 77, 255, 0.06);
  }

  code.thm {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent);
    background: transparent;
    padding: 0;
    word-break: break-word;
  }

  .obs {
    font-family: var(--font-mono);
    color: var(--color-text);
  }

  .pdg { color: var(--color-text); font-variant-numeric: tabular-nums; }
  .pdg .check {
    display: inline-block;
    color: var(--color-success);
    margin-right: 4px;
    font-weight: 700;
  }

  .tol {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
