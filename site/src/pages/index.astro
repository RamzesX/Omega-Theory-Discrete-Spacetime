---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import BadgeStrip from '../components/BadgeStrip.astro';
import PhysicsBox from '../components/PhysicsBox.astro';
import { HEADLINES, fmt } from '../data/status.mjs';

const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const GH = 'https://github.com/RamzesX/chaos-shield';
const GHLean = `${GH}/tree/main/PhysicsPapers/LeanFormalizationV2/OmegaTheory/Predictions`;
const GHCapstones = `${GH}/blob/main/PhysicsPapers/LeanFormalizationV2/OmegaTheory/Capstones`;
---

<BaseLayout title={`Discrete Spacetime · ${HEADLINES.cyclesShipped} Cycles · ${HEADLINES.ownTheoremsShort} Theorems`}>
  <Navigation slot="sidebar" />

  <HeroSection />

  <BadgeStrip />

  <!-- Honest scope — Tier 1 (peer-review-ready) vs Tier 2 (exploratory) -->
  <section class="scope-banner">
    <div class="scope-inner">
      <div class="scope-header">
        <span class="scope-tag">Honest scope · 2026-05-04</span>
        <h2 class="scope-title">Two stand-alone Lean&nbsp;4 results — plus an exploratory framework</h2>
      </div>
      <div class="scope-grid">
        <div class="scope-card scope-tier1">
          <div class="scope-eyebrow">Tier&nbsp;1 · peer-review-ready</div>
          <ol class="scope-list">
            <li>
              <strong>First Lean&nbsp;4 formalization of π-transcendence.</strong>
              24 files · ≈&nbsp;8&nbsp;400&nbsp;LOC · custom Lindemann–Weierstrass port · single-day single-thread closure (cycle&nbsp;64). Theorem <code>Real.pi_transcendental</code> returns <code>[propext,&nbsp;Classical.choice,&nbsp;Quot.sound]</code> on axiom audit.
            </li>
            <li>
              <strong>Discrete-substrate quantum-gravity core.</strong>
              8 sectors (<code>Variational/</code>, <code>HealingFlow/</code>, <code>Geometry/</code>, <code>Conservation/</code>, <code>Spacetime/</code>, <code>Tensor/</code>, <code>Torsion/</code>, <code>Defects/</code>) · ≈&nbsp;25&nbsp;500&nbsp;LOC of Mathlib-grade proof · 0 axioms in these sectors. Healing-flow PDE&nbsp;∂g/∂τ&nbsp;=&nbsp;-δF/δg with proven Lyapunov dissipation dF/dτ&nbsp;=&nbsp;-‖∇F‖²&nbsp;≤&nbsp;0.
            </li>
            <li>
              <strong>Signature-match bridging framework</strong> (2026-05-06, in progress).
              Each SM particle / force has a specific informational signature in the substrate, derivable two ways: (i) from substrate <code>informationStressEnergyTensor</code> + <code>gaugeInformation</code>, (ii) from standard physics textbook formulas. The <em>match theorem</em> is the bridge proof. First match shipped: the <strong>photon</strong> — substrate <code>(1/2)·Σ&nbsp;F²</code> matches textbook <em>(1/2)(|E|² + |B|²)</em> up to the natural factor of 2.
            </li>
          </ol>
          <p class="scope-foot">Submission targets: <em>Physical Review Letters</em> (2026-06), <em>Foundations of Physics</em> (2026-10). The signature-match dictionary is the project's central organizing contribution.</p>
        </div>
        <div class="scope-card scope-tier2">
          <div class="scope-eyebrow scope-eyebrow-2">Tier&nbsp;2 · research-grade exploratory</div>
          <p class="scope-text">
            Sections of the formal paper §3–§9 develop a broader algebraic framework Ω-Theory in which the Standard Model gauge group, dark sector, three-generation mass hierarchy, and bridges (ER=EPR, CPT, graviton energy, Susskind complexity, <em>d</em>_crit) are conjectured to emerge.
          </p>
          <p class="scope-text">
            The corresponding Lean witnesses compile (4&nbsp;926 build jobs GREEN, 0 sorry, 0 stub markers, 6 declared axioms — 4 sealed Hermite–Padé + 2 citation), but the <strong>physical interpretation is speculative</strong>. The <code>Foundations/</code> sector contains 240 files of which roughly 205 are mass-batch <em>CategoricalYonedaWitness</em> companions of low theorem density. Read this layer as a research-grade scaffold, not as peer-reviewed unified physics.
          </p>
          <p class="scope-foot scope-foot-mut">One Tier-2 prediction is empirically verified: <em>F(T) = F₀/(1+αT)</em> [Diraq 2024, Nature 627, 772]. Other identifications (mass hierarchy etc.) remain open.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cycle 64 milestone — Real.pi_transcendental retired (2026-04-27) -->
  <section class="milestone-banner">
    <div class="milestone-inner">
      <div class="milestone-badge">
        <span class="milestone-trophy" aria-hidden="true">★</span>
        <span class="milestone-tag">Cycle 64 milestone · 2026-04-27</span>
      </div>
      <h2 class="milestone-title">
        <code>Real.pi_transcendental</code> retired — axiom → theorem
      </h2>
      <p class="milestone-lede">
        First Lean 4 formalization of <strong>π-transcendence</strong> ever
        landed. The Lindemann–Weierstrass-shaped axiom that gated the entire
        OmegaTheory paper-headline footprint is now a derived theorem,
        cutting the project's primitive-assumption count from <b>5 → 4</b>.
        The remaining four are existence postulates for the four physical
        constants (c, ℏ, G_N, k_B) realised as Lean-core opaque bundles —
        no Mathlib gap, no `axiom` keyword, no Classical-choice surprises.
      </p>
      <ul class="milestone-stats">
        <li><b>60</b> autonomous proof sessions (s46–s105)</li>
        <li><b>14</b> hand-authored Lean files single-thread</li>
        <li><b>4454</b> build jobs GREEN · 0 sorry</li>
        <li><b>4 → 4</b> Lean-core axioms only ([propext, Classical.choice, Quot.sound])</li>
      </ul>
      <div class="milestone-files">
        <a href={`${GHCapstones}/Cycle64MasterCapstone.lean`} class="milestone-link" target="_blank" rel="noopener">
          <code>Cycle64MasterCapstone</code><span>12-conjunct master ↗</span>
        </a>
        <a href={`${GHCapstones}/PiTranscendenceAxiomRetirementFinal.lean`} class="milestone-link" target="_blank" rel="noopener">
          <code>PiTranscendenceAxiomRetirementFinal</code><span>retirement headline ↗</span>
        </a>
        <a href={`${GHCapstones}/PiHunchUnconditionalCapstone.lean`} class="milestone-link" target="_blank" rel="noopener">
          <code>PiHunchUnconditionalCapstone</code><span>π-Hunch Lean-core ↗</span>
        </a>
        <a href={`${GHCapstones}/PiTranscendenceConsequences.lean`} class="milestone-link" target="_blank" rel="noopener">
          <code>PiTranscendenceConsequences</code><span>π^n results ↗</span>
        </a>
        <a href={`${GHCapstones}/PiTranscendenceAlgebraicConsequences.lean`} class="milestone-link" target="_blank" rel="noopener">
          <code>PiTranscendenceAlgebraicConsequences</code><span>π+α, π·α ↗</span>
        </a>
        <a href={`${GHCapstones}/PiSqrt2LinearIndependence.lean`} class="milestone-link" target="_blank" rel="noopener">
          <code>PiSqrt2LinearIndependence</code><span>π ⟂ √2 ↗</span>
        </a>
        <a href={`${GHCapstones}/PiTranscendenceYonedaBridges.lean`} class="milestone-link" target="_blank" rel="noopener">
          <code>PiTranscendenceYonedaBridges</code><span>5 Yoneda bridges ↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Capstone pillar -->
  <section class="capstone-pillar">
    <div class="capstone-inner">
      <div class="capstone-left">
        <div class="eyebrow">Tier-2 capstone (research-grade)</div>
        <h2 class="capstone-title">
          <code>omega_theory_v2_final_meta_capstone</code>
        </h2>
        <p class="capstone-lede">
          A single Lean statement bundling <strong>{HEADLINES.cyclesShipped} cycles of substrate fits</strong> —
          Standard Model masses + CKM/PMNS mixing + Higgs sector +
          cosmological parameters + matter–antimatter asymmetry +
          dark sector — under a candidate four-irrational hypothesis
          (π, <em>e</em>, √2, Catalan G) on the discrete ℤ⁴ lattice. The Lean
          structure is sound; the physical identification is a research
          conjecture, not a peer-reviewed derivation. See the honest-scope
          banner above.
        </p>
        <ul class="capstone-stats">
          <li><b>{HEADLINES.cyclesShipped}</b> cycles shipped · cycles {HEADLINES.cyclesRange}</li>
          <li><b>{HEADLINES.ownTheoremsShort}</b> own theorems + {fmt.thousands(HEADLINES.grandTotalTheorems)} total with Mathlib</li>
          <li><b>{HEADLINES.buildJobsFmt}</b> build jobs GREEN · {HEADLINES.sorryCount} sorry</li>
          <li><b>{HEADLINES.physicalAxioms}</b> physical axioms · 0 mathematical</li>
        </ul>
        <div class="capstone-ctas">
          <a href={`${baseUrl}cycles/`} class="btn btn-primary">Open cycle catalogue</a>
          <a href={GHLean} class="btn btn-outline" target="_blank" rel="noopener">View Lean source</a>
        </div>
      </div>

      <div class="capstone-right">
        <div class="channel-stack">
          <div class="channel-row"><span class="channel-tag tag-pi">π</span><div><strong>heavy · gen 3</strong><span>m_t · m_b · m_W · m_Z · λ_H</span></div></div>
          <div class="channel-row"><span class="channel-tag tag-e">e</span><div><strong>middle · gen 2</strong><span>m_c · m_s · m_K · f_π · |V_cb|</span></div></div>
          <div class="channel-row"><span class="channel-tag tag-s2">√2</span><div><strong>light · gen 1 + cosmo</strong><span>m_u · m_d · m_ν · Λ · θ_QCD</span></div></div>
          <div class="channel-row"><span class="channel-tag tag-mix">π·e</span><div><strong>composed</strong><span>Jarlskog · λ_H · α_EM(m_Z)</span></div></div>
          <div class="channel-row"><span class="channel-tag tag-id">id</span><div><strong>identity</strong><span>m_H² = 2λv² · unitarity triangle</span></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <span class="eyebrow">§ 01 · What's machine-checked</span>
      <h2>Lean-verified core, exploratory periphery</h2>
      <p class="section-intro">
        Two pieces stand on their own — π-transcendence in Lean&nbsp;4 and
        a discrete-substrate quantum-gravity core. The Tier-2 broader
        framework is a research scaffold, not a peer-reviewed unified theory.
      </p>
    </div>

    <div class="card-grid">
      <FeatureCard
        icon="π"
        title="π-transcendence in Lean 4"
        accent="rose"
        description="First Lean 4 formalization of Real.pi_transcendental — 24 files, ~8 400 LOC, custom Lindemann–Weierstrass port, axiom audit Lean-core only."
        href={`${baseUrl}papers/paper-pi-transcendence-lean4-firstformalization/`}
      />
      <FeatureCard
        icon="∂"
        title="Healing-flow Lyapunov core"
        accent="jade"
        description="Discrete-substrate quantum gravity: PDE ∂g/∂τ = -δF/δg with proven dissipation dF/dτ = -‖∇F‖² ≤ 0, plus lattice Stokes/Hodge and Big-Bounce singularity avoidance."
        href={`${baseUrl}papers/paper-qm-from-discrete-gravity/`}
      />
      <FeatureCard
        icon="◈"
        title={`${HEADLINES.cyclesShipped} cycles · Tier 2`}
        accent="amber"
        description={`${HEADLINES.cyclesShipped} cycles of substrate fits anchored to PDG values — research-grade conjectural identification. One prediction empirically verified (gate fidelity, Diraq 2024).`}
        href={`${baseUrl}cycles/`}
      />
      <FeatureCard
        icon="⬢"
        title="Graph research · Neo4j"
        accent="azure"
        description={`V3-for-Lean: Magnetic Laplacian + Leiden + FastRP applied to the ${HEADLINES.ownTheoremsShort}-theorem Lean corpus. Paper target NeurIPS 2026 / ICLR 2027.`}
        href={`${baseUrl}algebra/`}
      />
      <FeatureCard
        icon="✓"
        title="No-stubs discipline"
        accent="magenta"
        description={`${HEADLINES.buildJobsFmt} build jobs GREEN, ${HEADLINES.sorryCount} sorry, 0 placeholder stubs, 6 declared axioms (4 Hermite-Padé + 2 citation). Run lake build and verify yourself.`}
        href={`${baseUrl}lean/`}
      />
      <FeatureCard
        icon="↯"
        title="Chronology protection"
        accent="azure"
        description="Tier-2: substrate-side derivation that wormholes can exist while time travel cannot, encoded in Appendix S."
        href={`${baseUrl}papers/appendix-s-stable-wormholes-and-chronology-protection/`}
      />
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <span class="eyebrow">§ 02 · The thesis</span>
      <h2>The single postulate</h2>
    </div>

    <PhysicsBox type="postulate" title="Postulate">
      <p>
        Spacetime is fundamentally discrete — a four-dimensional integer lattice
        (ℤ⁴) with spacing at the Planck length (~10⁻³⁵ m).
      </p>
    </PhysicsBox>

    <p class="section-text">From this single assumption, the theory derives:</p>

    <ul class="derivation-list">
      <li><strong>Cosmological constant</strong> Λ = 1.1×10⁻⁵² m⁻², on √2-channel at N≈10
        <code>Lambda_CC_substrate_fit</code></li>
      <li><strong>Dark energy</strong> w = −1 from photon-coherence reservoir
        <code>darkEnergyEquationOfState_w</code></li>
      <li><strong>Black-hole entropy</strong> S = A/4
        <code>bh_entropy_bekenstein</code></li>
      <li><strong>Standard Model mass hierarchy</strong> across 3 generations
        <code>three_channel_partition_theorem</code></li>
      <li><strong>Fourth Noether law</strong> — information conservation ∂<sub>μ</sub>J<sup>μ</sup><sub>I</sub> = 0
        <code>fourth_noether_law_harmonic</code></li>
      <li><strong>Strong-CP resolution</strong> without axion (N = 6 beats experiment by 10 orders)
        <code>strongCPThetaBound</code></li>
    </ul>
  </section>

  <section class="section">
    <div class="section-header">
      <span class="eyebrow">§ 03 · Empirical status</span>
      <h2>Already confirmed</h2>
    </div>

    <div class="confirm-grid">
      <div class="confirm-card">
        <div class="confirm-icon" aria-hidden="true">✓</div>
        <div class="confirm-body">
          <strong>Gate fidelity scaling (2024)</strong>
          <p>Predicted F(T) = F₀/(1+αT) scaling confirmed by IBM / Google
             quantum-computer data. Temperature dependence matches discrete-spacetime
             thermal noise model.</p>
          <span class="confirm-ref mono">Diraq · Nature 627, 772–777 (2024)</span>
        </div>
      </div>
      <div class="confirm-card">
        <div class="confirm-icon" aria-hidden="true">✓</div>
        <div class="confirm-body">
          <strong>Dark-energy equation of state</strong>
          <p>Predicted w = −1 ± 0.03 from lattice geometry. DESI 2024 measures
             w = −0.99 ± 0.05 — inside predicted bounds.</p>
          <span class="confirm-ref mono">DESI DR1 · 2024</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <span class="eyebrow">§ 04 · Where to start</span>
      <h2>Reading guide</h2>
    </div>

    <ol class="reading-path">
      <li>
        <a href={`${baseUrl}papers/main-paper-postulates/`} class="reading-step">
          <span class="step-number">01</span>
          <div class="step-content">
            <strong>Origin story</strong>
            <span>Main paper · the single postulate and central thesis</span>
          </div>
        </a>
      </li>
      <li>
        <a href={`${baseUrl}papers/unified-theory-diagram/`} class="reading-step">
          <span class="step-number">02</span>
          <div class="step-content">
            <strong>Visual overview</strong>
            <span>11-level diagram showing how everything connects</span>
          </div>
        </a>
      </li>
      <li>
        <a href={`${baseUrl}papers/completeomegatheory/`} class="reading-step">
          <span class="step-number">03</span>
          <div class="step-content">
            <strong>Formal paper (Tier 1 / Tier 2 split)</strong>
            <span>Honest scope: π transcendence + substrate uncertainty proven; SM derivations conjectured</span>
          </div>
        </a>
      </li>
      <li>
        <a href={`${baseUrl}cycles/`} class="reading-step featured">
          <span class="step-number">04</span>
          <div class="step-content">
            <strong>{HEADLINES.cyclesShipped} cycles · {HEADLINES.ownTheoremsShort} theorems</strong>
            <span>Cycle-by-cycle substrate fits with GitHub links to each Lean theorem</span>
          </div>
        </a>
      </li>
      <li>
        <a href={`${baseUrl}papers/paper-dark-energy-preview-v1/`} class="reading-step">
          <span class="step-number">05</span>
          <div class="step-content">
            <strong>Dark-energy preview paper</strong>
            <span>Cosmological constant resolved via photon redshift reservoir</span>
          </div>
        </a>
      </li>
      <li>
        <a href={`${baseUrl}lean/`} class="reading-step">
          <span class="step-number">06</span>
          <div class="step-content">
            <strong>Lean formalization</strong>
            <span>Machine-verified capstone theorems · build instructions</span>
          </div>
        </a>
      </li>
    </ol>
  </section>

  <section class="section cta-section">
    <h2>Explore the theory</h2>
    <p class="section-intro">
      25 papers · {HEADLINES.cyclesShipped} cycles of formal predictions · {fmt.thousands(HEADLINES.grandTotalTheorems)} Lean declarations (incl. Mathlib).
    </p>
    <div class="cta-buttons">
      <a href={`${baseUrl}cycles/`} class="btn btn-primary">See {HEADLINES.cyclesShipped} cycles</a>
      <a href={`${baseUrl}papers/main-paper-postulates/`} class="btn btn-outline">Start reading</a>
      <a href={GH} class="btn btn-outline" target="_blank" rel="noopener">View on GitHub</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Honest scope banner (Tier 1 / Tier 2) --- */
  .scope-banner {
    margin: var(--space-xl) 0 var(--space-2xl);
    padding: var(--space-xl);
    background: linear-gradient(140deg, rgba(95, 184, 255, 0.10), rgba(79, 217, 154, 0.06) 60%, rgba(245, 166, 35, 0.04) 100%);
    border: 1.5px solid rgba(95, 184, 255, 0.45);
    border-radius: var(--radius-xl);
  }
  .scope-inner { position: relative; }
  .scope-header { margin-bottom: var(--space-md); }
  .scope-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-azure);
    font-weight: 600;
    display: block;
    margin-bottom: var(--space-2xs);
  }
  .scope-title {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    margin: 0;
    border: 0;
    padding: 0;
    line-height: 1.25;
  }
  .scope-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }
  .scope-card {
    padding: var(--space-lg);
    background: rgba(10, 14, 26, 0.45);
    border: 1px solid var(--color-seam);
    border-radius: var(--radius-lg);
  }
  .scope-tier1 { border-color: rgba(79, 217, 154, 0.45); }
  .scope-tier2 { border-color: rgba(200, 110, 255, 0.30); }
  .scope-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-jade);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }
  .scope-eyebrow-2 { color: var(--color-magenta); }
  .scope-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: scope-counter;
  }
  .scope-list li {
    position: relative;
    padding: var(--space-xs) 0 var(--space-sm) calc(var(--space-md) + 16px);
    counter-increment: scope-counter;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-text-dim);
    border-bottom: 1px dashed var(--color-seam);
  }
  .scope-list li:last-child { border-bottom: 0; }
  .scope-list li::before {
    content: counter(scope-counter);
    position: absolute;
    top: var(--space-xs);
    left: 0;
    width: 22px; height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-jade);
    border-radius: 50%;
    color: var(--color-jade);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
  }
  .scope-list strong { color: var(--color-text); }
  .scope-list code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    color: var(--color-amber);
    background: rgba(245, 166, 35, 0.08);
    border: 1px solid rgba(245, 166, 35, 0.20);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
  }
  .scope-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-dim);
    margin: 0 0 var(--space-sm);
  }
  .scope-text strong { color: var(--color-magenta); }
  .scope-text em { color: var(--color-amber); font-style: italic; }
  .scope-text code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--color-text);
    background: rgba(95, 184, 255, 0.08);
    border: 1px solid rgba(95, 184, 255, 0.16);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
  }
  .scope-foot {
    margin: var(--space-sm) 0 0;
    font-size: 0.82rem;
    color: var(--color-text-mut);
    font-family: var(--font-mono);
  }
  .scope-foot em { color: var(--color-jade); font-style: italic; }
  .scope-foot-mut em { color: var(--color-amber); }
  @media (max-width: 900px) {
    .scope-grid { grid-template-columns: 1fr; }
  }

  /* --- Cycle 64 milestone banner --- */
  .milestone-banner {
    margin: var(--space-xl) 0 var(--space-2xl);
    padding: var(--space-xl);
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.14), rgba(255, 107, 136, 0.08) 50%, rgba(200, 110, 255, 0.06) 100%);
    border: 1.5px solid rgba(245, 166, 35, 0.5);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 32px rgba(245, 166, 35, 0.12);
  }

  .milestone-banner::after {
    content: "";
    position: absolute;
    bottom: -30%; left: -10%;
    width: 380px; height: 380px;
    background: radial-gradient(circle, rgba(245, 166, 35, 0.18), transparent 70%);
    pointer-events: none;
  }

  .milestone-inner { position: relative; }

  .milestone-badge {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .milestone-trophy {
    font-size: 1.4rem;
    color: var(--color-amber);
    filter: drop-shadow(0 0 8px rgba(245, 166, 35, 0.5));
  }

  .milestone-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-amber);
    font-weight: 600;
  }

  .milestone-title {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    margin: 0 0 var(--space-sm);
    border: 0;
    padding: 0;
    line-height: 1.2;
  }

  .milestone-title code {
    font-family: var(--font-mono);
