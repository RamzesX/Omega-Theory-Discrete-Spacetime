---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PhysicsBox from '../components/PhysicsBox.astro';

const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const GH = 'https://github.com/RamzesX/chaos-shield';
// Capstone lives on native-ext4 working dir (~/lean-v2/); syncs to main on next push.
const GHLean = `${GH}/tree/main/PhysicsPapers/LeanFormalizationV2/OmegaTheory/Predictions`;
---

<BaseLayout title="Discrete Spacetime · 14 Cycles · 84 Predictions">
  <Navigation slot="sidebar" />

  <HeroSection />

  <!-- Capstone pillar -->
  <section class="capstone-pillar">
    <div class="capstone-inner">
      <div class="capstone-left">
        <div class="eyebrow">Signature theorem</div>
        <h2 class="capstone-title">
          <code>omega_theory_grand_capstone</code>
        </h2>
        <p class="capstone-lede">
          A single Lean statement bundling <strong>84 PDG-consistent
          predictions</strong> across <strong>14 shipping cycles</strong>:
          Standard Model masses + CKM/PMNS mixing + Higgs sector + cosmological
          parameters — all derivable from 3 irrationals (π, <em>e</em>, √2) and
          healing-flow dynamics on the discrete ℤ⁴ lattice.
        </p>
        <ul class="capstone-stats">
          <li><b>14</b> cycles shipped · cycles 9–23</li>
          <li><b>84</b> headline substrate fits · PDG-anchored</li>
          <li><b>3 818</b> build jobs GREEN · 0 sorry</li>
          <li><b>8</b> physical axioms · no mathematical axioms</li>
        </ul>
        <div class="capstone-ctas">
          <a href={`${baseUrl}cycles/`} class="btn btn-primary">Open cycle catalogue</a>
          <a href={GHLean} class="btn btn-outline" target="_blank" rel="noopener">View Lean source ↗</a>
        </div>
      </div>
      <div class="capstone-right">
        <div class="mini-stack">
          <div class="mini-row"><span class="tag tag-pi">π</span><span>heavy (gen 3) · m_t, m_b, m_W, m_Z, λ_H</span></div>
          <div class="mini-row"><span class="tag tag-e">e</span><span>middle (gen 2) · m_c, m_s, m_K, f_π, |V_cb|</span></div>
          <div class="mini-row"><span class="tag tag-s2">√2</span><span>light (gen 1 + cosmo) · m_u, m_d, m_ν, Λ, θ_QCD</span></div>
          <div class="mini-row"><span class="tag tag-mix">π·e</span><span>composed · Jarlskog, λ_H, α_EM(m_Z)</span></div>
          <div class="mini-row"><span class="tag tag-id">id</span><span>identity · m_H² = 2λv², unitarity triangle</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">What makes this different</h2>
    <p class="section-intro">
      Unlike other quantum-gravity proposals, OmegaTheory starts from one
      postulate and derives the rest — mechanically checked.
    </p>

    <div class="card-grid">
      <FeatureCard
        icon="◇"
        title="One postulate → everything"
        description="From 'spacetime = discrete ℤ⁴ at Planck scale' derive: cosmological constant, dark energy, black-hole entropy, Standard Model masses, CKM/PMNS."
        href={`${baseUrl}papers/main-paper-postulates/`}
      />
      <FeatureCard
        icon="◈"
        title="84 concrete predictions"
        description="Not philosophy — 14 cycles of substrate fits anchored to PDG central values. One already verified (gate fidelity scaling, Diraq 2024)."
        href={`${baseUrl}cycles/`}
      />
      <FeatureCard
        icon="✓"
        title="Machine-verified"
        description="Every claim is a Lean theorem. 3,818 build jobs, 0 sorry, 8 physical axioms. Run `lake build` and verify."
        href={`${baseUrl}lean/`}
      />
      <FeatureCard
        icon="●"
        title="No time travel"
        description="Chronology protection proved as a mathematical theorem. Wormholes can exist; time travel cannot."
        href={`${baseUrl}papers/appendix-s-stable-wormholes-and-chronology-protection/`}
      />
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">The single postulate</h2>

    <PhysicsBox type="postulate" title="Postulate">
      <p>
        Spacetime is fundamentally discrete — a four-dimensional integer lattice
        (ℤ⁴) with spacing at the Planck length (~10⁻³⁵ m).
      </p>
    </PhysicsBox>

    <p class="section-text">From this single assumption, the theory derives:</p>

    <ul class="derivation-list">
      <li><strong>Cosmological constant</strong> Λ = 1.1×10⁻⁵² m⁻², on √2-channel at N≈10 (substrate fit <code>Lambda_CC_substrate_fit</code>)</li>
      <li><strong>Dark energy</strong> w = −1 from photon-coherence reservoir (<code>darkEnergyEquationOfState_w</code>)</li>
      <li><strong>Black-hole entropy</strong> S = A/4 (<code>bh_entropy_bekenstein</code>)</li>
      <li><strong>Standard Model mass hierarchy</strong> across 3 generations (<code>three_channel_partition_theorem</code>)</li>
      <li><strong>Fourth Noether law</strong> — information conservation ∂<sub>μ</sub>J<sup>μ</sup><sub>I</sub> = 0 (<code>fourth_noether_law_harmonic</code>)</li>
      <li><strong>Strong CP resolution</strong> without axion (<code>strongCPThetaBound</code>, N=6 beats experiment by 10 orders)</li>
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">Already confirmed</h2>

    <div class="confirm-grid">
      <div class="confirm-card">
        <div class="confirm-icon">✓</div>
        <div>
          <strong>Gate fidelity scaling (2024)</strong>
          <p>Predicted F(T) = F₀/(1+αT) scaling confirmed by IBM / Google
          quantum-computer data. Temperature dependence matches discrete-spacetime
          thermal noise model.</p>
          <span class="confirm-ref">Diraq · Nature 627, 772-777 (2024)</span>
        </div>
      </div>
      <div class="confirm-card">
        <div class="confirm-icon">✓</div>
        <div>
          <strong>Dark energy equation of state</strong>
          <p>Predicted w = −1 ± 0.03 from lattice geometry. DESI 2024 measures
          w = −0.99 ± 0.05 — inside predicted bounds.</p>
          <span class="confirm-ref">DESI DR1 · 2024</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Reading guide</h2>

    <div class="reading-path">
      <a href={`${baseUrl}papers/main-paper-postulates/`} class="reading-step">
        <span class="step-number">1</span>
        <div class="step-content">
          <strong>Origin story</strong>
          <p>Main paper · the single postulate and central thesis</p>
        </div>
      </a>
      <a href={`${baseUrl}papers/unified-theory-diagram/`} class="reading-step">
        <span class="step-number">2</span>
        <div class="step-content">
          <strong>Visual overview</strong>
          <p>11-level diagram showing how everything connects</p>
        </div>
      </a>
      <a href={`${baseUrl}papers/complete-omega-theory-unified-framework/`} class="reading-step">
        <span class="step-number">3</span>
        <div class="step-content">
          <strong>Complete framework</strong>
          <p>Full technical treatment with all equations</p>
        </div>
      </a>
      <a href={`${baseUrl}cycles/`} class="reading-step featured">
        <span class="step-number">4</span>
        <div class="step-content">
          <strong>14 cycles · 84 predictions</strong>
          <p>Cycle-by-cycle substrate fits, each with a GitHub link to the Lean theorem</p>
        </div>
      </a>
      <a href={`${baseUrl}papers/paper-dark-energy-preview-v1/`} class="reading-step">
        <span class="step-number">5</span>
        <div class="step-content">
          <strong>Dark energy preview paper</strong>
          <p>Draft manuscript: cosmological constant resolved via photon redshift reservoir</p>
        </div>
      </a>
      <a href={`${baseUrl}lean/`} class="reading-step">
        <span class="step-number">6</span>
        <div class="step-content">
          <strong>Lean formalization</strong>
          <p>Machine-verified capstone theorems · build instructions</p>
        </div>
      </a>
    </div>
  </section>

  <section class="section cta-section">
    <h2 class="section-title">Explore the theory</h2>
    <p class="section-intro">
      25 papers · 14 cycles of formal predictions · 11K+ Lean declarations.
    </p>
    <div class="cta-buttons">
      <a href={`${baseUrl}cycles/`} class="btn btn-primary">See 14 cycles</a>
      <a href={`${baseUrl}papers/main-paper-postulates/`} class="btn btn-outline">Start reading</a>
      <a href={GH} class="btn btn-outline" target="_blank" rel="noopener">View on GitHub ↗</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Capstone pillar */
  .capstone-pillar {
    margin: var(--space-2xl) 0 var(--space-3xl);
    padding: var(--space-xl);
    background: linear-gradient(135deg, rgba(124, 77, 255, 0.18), rgba(0, 212, 255, 0.10), rgba(255, 215, 64, 0.05));
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 40px rgba(124, 77, 255, 0.25);
  }

  .capstone-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
  }

  .capstone-title {
    font-size: 1.7rem;
    margin: 0 0 var(--space-md);
    border: 0;
    padding: 0;
  }

  .capstone-title code {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    color: var(--color-accent);
    background: transparent;
    padding: 0;
    font-weight: 700;
    word-break: break-word;
  }

  .capstone-lede {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .capstone-lede em {
    color: var(--color-accent);
    font-style: italic;
  }

  .capstone-stats {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs) var(--space-md);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .capstone-stats li {
    padding: 4px 0;
  }

  .capstone-stats b {
    color: var(--color-primary-light);
    font-family: var(--font-display);
    font-size: 1.1em;
    font-variant-numeric: tabular-nums;
  }

  .capstone-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .mini-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mini-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 6px 10px;
    background: rgba(10, 10, 15, 0.45);
    border-radius: var(--radius-md);
    font-size: 0.83rem;
    color: var(--color-text-muted);
  }

  .mini-row .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 100px;
    border: 1px solid;
    text-align: center;
    min-width: 40px;
  }

  .tag-pi  { background: rgba(255, 82, 82, 0.2);  color: #ff8585; border-color: #ff5252; }
  .tag-e   { background: rgba(255, 215, 64, 0.2); color: #ffd740; border-color: #ffd740; }
  .tag-s2  { background: rgba(0, 230, 118, 0.2);  color: #00e676; border-color: #00e676; }
  .tag-mix { background: rgba(124, 77, 255, 0.2); color: #b47cff; border-color: #7c4dff; }
  .tag-id  { background: rgba(0, 212, 255, 0.2);  color: #7fe5ff; border-color: #00d4ff; }

  /* Sections */
  .section {
    margin-bottom: var(--space-3xl);
  }

  .section-title {
    font-size: 1.8rem;
    margin-bottom: var(--space-sm);
  }

  .section-intro {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    max-width: 42rem;
  }

  .section-text {
    font-size: 1.02rem;
    line-height: 1.75;
    margin-bottom: var(--space-md);
  }

  .derivation-list {
    list-style: none;
    padding: 0;
  }

  .derivation-list li {
    position: relative;
    padding-left: var(--space-xl);
    margin-bottom: var(--space-sm);
    line-height: 1.65;
    font-size: 0.98rem;
  }

  .derivation-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-secondary);
    font-weight: bold;
  }

  .derivation-list code {
    font-size: 0.85rem;
    color: var(--color-accent);
    background: rgba(255, 215, 64, 0.08);
  }

  /* Confirmed */
  .confirm-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .confirm-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: rgba(0, 230, 118, 0.08);
    border: 1px solid rgba(0, 230, 118, 0.3);
    border-radius: var(--radius-md);
  }

  .confirm-icon {
    font-size: 1.4rem;
    color: var(--color-success);
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-success);
    border-radius: 50%;
  }

  .confirm-card strong {
    display: block;
    margin-bottom: 6px;
    color: var(--color-text);
  }

  .confirm-card p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .confirm-ref {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-success);
    margin-top: 6px;
  }

  /* Reading path */
  .reading-path {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .reading-step {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--gradient-card);
    border: 1px solid rgba(124, 77, 255, 0.2);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }

  .reading-step:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .reading-step.featured {
    background: linear-gradient(145deg, rgba(255, 215, 64, 0.14), rgba(124, 77, 255, 0.1));
    border-color: var(--color-accent);
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--gradient-primary);
    border-radius: 50%;
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    flex-shrink: 0;
    font-family: var(--font-mono);
  }

  .reading-step.featured .step-number {
    background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
  }

  .step-content strong {
    display: block;
    font-size: 1rem;
    margin-bottom: 3px;
    color: var(--color-text);
  }

  .step-content p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .cta-section {
    text-align: center;
    padding: var(--space-2xl);
    background: var(--gradient-card);
    border-radius: var(--radius-xl);
    border: 1px solid rgba(124, 77, 255, 0.2);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    margin-top: var(--space-md);
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .capstone-inner { grid-template-columns: 1fr; }
    .capstone-stats { grid-template-columns: 1fr; }
    .confirm-grid { grid-template-columns: 1fr; }
    .reading-path { grid-template-columns: 1fr; }
  }
</style>
</BaseLayout>