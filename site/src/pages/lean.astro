  {
    icon: 'ψ',
    name: 'Quantum mechanics (10 von-Neumann postulates + Bell)',
    accent: 'magenta',
    blurb: 'Schrödinger, Born rule, two-slit, Heisenberg, measurement, CHSH = 2√2 — derived from substrate, not postulated.',
    files: [
      { path: 'Emergence/QuantumMechanicsCapstone.lean', label: 'QuantumMechanicsCapstone',   desc: 'grand_qm_emergence' },
      { path: 'Emergence/Decoherence.lean',              label: 'Decoherence',                desc: 'environmental coherence loss' },
      { path: 'Emergence/PathIntegralInterference.lean', label: 'PathIntegralInterference',   desc: 'interference from substrate' },
      { path: 'Emergence/CHSHBellNonlocality.lean',      label: 'CHSHBellNonlocality',        desc: 'Tsirelson bound 2√2 > 2' },
    ],
  },
