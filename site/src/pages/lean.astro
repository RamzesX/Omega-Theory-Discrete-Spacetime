      { path: 'Predictions/StrongCPThetaBound.lean',                label: 'StrongCPThetaBound',              desc: 'θ_QCD beats experiment ×10¹⁰' },
      { path: 'Predictions/ProtonMassFromLambdaQCD.lean',           label: 'ProtonMassFromLambdaQCD',         desc: 'm_p via Λ_QCD one-loop RG' },
