    blurb: 'HiggsField := computationalUncertainty. Three-channel mass partition across SM fermions.',
    files: [
      { path: 'Emergence/HiggsMechanism.lean',                      label: 'HiggsMechanism',                  desc: 'Higgs from δ_comp' },
      { path: 'Emergence/HiggsAndMassHierarchy.lean',               label: 'HiggsAndMassHierarchy',           desc: 'higgs_mass_hierarchy_first_bundle' },
      { path: 'Predictions/MassRatioNumerical.lean',                label: 'MassRatioNumerical',              desc: 'm_e:m_μ:m_τ ratios' },
      { path: 'Predictions/PiHunchMassOrdering.lean',               label: 'PiHunchMassOrdering',             desc: 'π > G > e > √2 ordering' },
    ],
  },
  {
    icon: 'Λ',
    name: 'Dark energy + cosmological constant',
    accent: 'azure',
    blurb: 'w = -1 from photon-coherence reservoir. Λ on √2-channel at N≈10. DESI 2024 inside predicted bounds.',
    files: [
      { path: 'Predictions/CosmologicalRedshiftDarkEnergy.lean',     label: 'CosmologicalRedshiftDarkEnergy', desc: 'darkEnergyEquationOfState_w' },
      { path: 'Predictions/KBCVoidDarkEnergy.lean',                 label: 'KBCVoidDarkEnergy',               desc: 'KBC void substrate signature' },
      { path: 'Predictions/RedshiftFloor.lean',                     label: 'RedshiftFloor',                    desc: 'photon-coherence floor' },
    ],
  },
  {
    icon: '⌅',
    name: 'Inflation + healing flow dynamics',
    accent: 'jade',
    blurb: 'Lyapunov + LaSalle convergence. Healing flow drives inflation; no inflaton field needed.',
    files: [
      { path: 'HealingFlow/Convergence.lean',                       label: 'HealingFlow/Convergence',         desc: 'LaSalle convergence' },
      { path: 'HealingFlow/Lyapunov.lean',                          label: 'HealingFlow/Lyapunov',            desc: 'Lyapunov function' },
      { path: 'Emergence/InflationFromHealingFlow.lean',            label: 'InflationFromHealingFlow',        desc: 'healingFlow_drives_inflation' },
    ],
  },
  {
    icon: '↺',
    name: 'Big Bounce + cyclic cosmology',
    accent: 'rose',
    blurb: 'Spin-torsion (Popławski) avoids singularity. Baby-universe branch + sterile-ν / DM channel from Catalan-G.',
    files: [
      { path: 'Torsion/SpinTorsion.lean',                           label: 'Torsion/SpinTorsion',             desc: 'Einstein-Cartan spin-torsion' },
      { path: 'Torsion/BigBounce.lean',                             label: 'Torsion/BigBounce',               desc: 'substrate_avoids_singularity' },
      { path: 'Torsion/BabyUniverse.lean',                          label: 'Torsion/BabyUniverse',            desc: 'baby-universe branch' },
      { path: 'Predictions/CyclicCosmology.lean',                   label: 'CyclicCosmology',                  desc: 'cycle 34 cyclic closure' },
    ],
  },
  {
    icon: '◆',
    name: 'Bell nonlocality + CHSH',
    accent: 'magenta',
    blurb: 'Substrate violates classical CHSH bound 2; saturates Tsirelson 2√2. Both bounds proved as Lean theorems.',
    files: [
      { path: 'Emergence/CHSHBellNonlocality.lean',                 label: 'CHSHBellNonlocality',             desc: 'classical_CHSH_bound + substrate_CHSH_violation' },
    ],
  },
  {
    icon: '⊕',
    name: 'Baryogenesis + leptogenesis',
    accent: 'amber',
    blurb: 'Matter-antimatter ratio bounded from substrate. Sphaleron + Sakharov conditions formalized.',
    files: [
      { path: 'Predictions/BaryogenesisLeptogenesis.lean',          label: 'BaryogenesisLeptogenesis',        desc: 'cycle 33 baryon asymmetry' },
      { path: 'Predictions/JarlskogFromIrrationals.lean',           label: 'JarlskogFromIrrationals',         desc: 'CKM J via π·e composed' },
    ],
  },
  {
    icon: 'ν',
    name: 'Sterile neutrino + dark matter (4th channel)',
    accent: 'azure',
    blurb: 'Catalan G as 4th irrational channel = sterile / DM slot. Connes 4-channel calibration.',
    files: [
      { path: 'Predictions/SterileNeutrinoFromFourthIrrational.lean', label: 'SterileNeutrinoFromFourthIrrational', desc: 'Z_sterile_from_connes_DF' },
      { path: 'Predictions/NeutrinoMassFloor.lean',                 label: 'NeutrinoMassFloor',                desc: 'm_ν floor from substrate' },
      { path: 'Predictions/LeptonN4Uniqueness.lean',                label: 'LeptonN4Uniqueness',               desc: 'N=4 lepton uniqueness' },
    ],
  },
  {
    icon: '★',
    name: 'Black-hole information paradox',
    accent: 'jade',
    blurb: 'Information survives via substrate memory. UV finiteness from δ_comp natural regulator.',
    files: [
      { path: 'Predictions/QuantumGravityBHInfo.lean',              label: 'QuantumGravityBHInfo',            desc: 'cycle 37 BH info paradox' },
      { path: 'Predictions/SecondLawAndHolography.lean',            label: 'SecondLawAndHolography',          desc: 'cycle 38 holographic bound' },
      { path: 'Predictions/ProtonStabilityHawkingSink.lean',        label: 'ProtonStabilityHawkingSink',      desc: 'proton stability vs Hawking' },
    ],
  },
];
---

<BaseLayout
  title={`Lean 4 Formalization · Build ${HEADLINES.buildJobsFmt} GREEN`}
  description={`Machine-verified OmegaTheory V2: ${HEADLINES.cyclesShipped} cycles shipped, ${HEADLINES.ownTheoremsShort} own theorems + ${fmt.thousands(HEADLINES.grandTotalTheorems)} total with Mathlib, ${HEADLINES.sorryCount} sorry, ${HEADLINES.physicalAxioms} physical axioms.`}
>
  <Navigation slot="sidebar" />

  <header class="header-section">
    <div class="header-eyebrow">Formal verification · Lean 4 + Mathlib v4.29 · cycle 64 · 2026-04-27</div>
    <h1 class="page-title">OmegaTheory V2 — {HEADLINES.buildJobsFmt} jobs GREEN</h1>
    <p class="page-subtitle">
      A living machine-verified proof that Standard Model parameters, gravitational
      dynamics, and cosmological observables follow from {HEADLINES.physicalAxioms} physical constants on
      a Planck-scale ℤ⁴ lattice. Every claim on this site terminates in a Lean theorem.
      <strong>Cycle 64 (2026-04-27): <code>Real.pi_transcendental</code> retired
      from axiom to theorem — first Lean 4 formalization of π-transcendence ever.</strong>
    </p>
  </header>

  <section class="stats-section">
    <div class="stat-card hero-stat"><span class="stat-value">{HEADLINES.buildJobsFmt}</span><span class="stat-label">build jobs GREEN</span></div>
    <div class="stat-card"><span class="stat-value">{HEADLINES.sorryCount}</span><span class="stat-label">sorry</span></div>
    <div class="stat-card"><span class="stat-value">{HEADLINES.physicalAxioms}</span><span class="stat-label">physical axioms</span></div>
    <div class="stat-card"><span class="stat-value">{HEADLINES.cyclesShipped}</span><span class="stat-label">cycles shipped ({HEADLINES.cyclesRange})</span></div>
    <div class="stat-card"><span class="stat-value">{HEADLINES.ownTheoremsShort}</span><span class="stat-label">own theorems</span></div>
    <div class="stat-card"><span class="stat-value">{fmt.thousands(HEADLINES.grandTotalTheorems)}</span><span class="stat-label">total (+ Mathlib)</span></div>
    <div class="stat-card"><span class="stat-value">{HEADLINES.leanFiles}</span><span class="stat-label">Lean files</span></div>
    <div class="stat-card"><span class="stat-value">v4.29</span><span class="stat-label">Mathlib / Lean</span></div>
  </section>

  <section class="section">
    <h2>Capstone theorems</h2>
    <p class="intro">
      Each entry below is a single Lean statement bundling a wide class of physical
      facts. Clicking the arrow sends you to the source on GitHub.
    </p>

    <ul class="capstone-list">
      <li>
        <div class="cap-head">
          <code class="cap-name">grand_qm_emergence</code>
          <a class="cap-link" href={`${GH}/OmegaTheory/Emergence/QuantumMechanicsCapstone.lean`} target="_blank" rel="noopener">open ↗</a>
        </div>
        <p class="cap-desc">
          Schrödinger evolution, Born rule conservation, non-relativistic limit,
          two-slit interference, Heisenberg uncertainty, measurement/collapse, and
          <code>chshTsirelsonBell = 2√2 &gt; 2</code> — seven von-Neumann postulates
          plus Bell nonlocality from a single discrete substrate.
        </p>
      </li>
      <li>
        <div class="cap-head">
          <code class="cap-name">vacuum_einstein_emergence_regime</code>
          <a class="cap-link" href={`${GH}/OmegaTheory/Emergence/EinsteinEmergence.lean`} target="_blank" rel="noopener">open ↗</a>
        </div>
        <p class="cap-desc">
          Einstein's field equations <code>G_μν = (8πG/c⁴) T_μν + O(ℓ_P)</code>
          emerge at healing-flow equilibrium, axiom-free on 7 regimes (flat,
          linearised, FRW, Bianchi-I, de Sitter, Kerr, static-spherical) via
          <code>HpwEliminableRegime</code>.
        </p>
      </li>
      <li>
        <div class="cap-head">
          <code class="cap-name">omega_theory_v2_final_meta_capstone</code>
          <a class="cap-link" href={`${GH}/OmegaTheory/Predictions/OmegaTheoryGrandCapstoneV2.lean`} target="_blank" rel="noopener">open ↗</a>
        </div>
        <p class="cap-desc">
          Grand meta-capstone (Polaris, cycle 43, 2026-04-20) bundling all {HEADLINES.cyclesShipped} shipped
          cycles ({HEADLINES.cyclesRange}): Standard Model + cosmology + Mekbuda's 60-theorem
          backlog (electroweak unification, Connes 4-channel, Yukawa from D_F,
          baryogenesis, cyclic cosmology, Catalan-G sterile channel). Composed with
          the cycle-23 <code>omega_theory_grand_capstone</code> as a sub-conjunct.
          <a href={`${baseUrl}cycles/`} class="inline-link">See the cycle-by-cycle breakdown →</a>
        </p>
      </li>
      <li>
        <div class="cap-head">
          <code class="cap-name">fourth_noether_law_harmonic</code>
          <a class="cap-link" href={`${GH}/OmegaTheory/Conservation/Information.lean`} target="_blank" rel="noopener">open ↗</a>
        </div>
        <p class="cap-desc">
          Information conservation <code>∂_μ J^μ_I = 0</code> proved from
          shift symmetry on the lattice. A genuine Fourth Noether law.
        </p>
      </li>
      <li>
        <div class="cap-head">
          <code class="cap-name">three_channel_partition_theorem</code>
          <a class="cap-link" href={`${baseUrl}cycles/`} class="cap-link-internal">see cycles →</a>
        </div>
        <p class="cap-desc">
          π / e / √2 truncation channels are disjoint and cover every observable:
          gen 3 on π, gen 2 on e, gen 1 + cosmology on √2. Three irrationals ↔
          three generations.
        </p>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>Results by physics domain</h2>
    <p class="intro">
      Every claim is a Lean theorem. Subsections below group the corpus by
      physical sector — each card links to the Lean source file on GitHub.
      The cycle-64 milestone (π-transcendence retirement, 2026-04-27)
      sits at the top.
    </p>

    <div class="domain-stack">
      {physicsDomains.map((d) => (
        <div class:list={['domain-card', `domain-${d.accent}`]}>
          <div class="domain-head">
            <span class="domain-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.name}</h3>
          </div>
          <p class="domain-blurb">{d.blurb}</p>
          <ul class="domain-files">
            {d.files.map((f) => (
              <li>
                <a href={`${GHB}/${f.path}`} target="_blank" rel="noopener">
                  <code>{f.label}</code>
                  <span>{f.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Architecture (12 layers)</h2>
    <p class="intro">Each layer depends only on layers above it.</p>

    <div class="layer-grid">
      {([
        { n: '01', name: 'Foundations',  body: 'ErrorAlgebra · ErrorLieAlgebra · ErrorForms · ErrorHopf', dir: 'Foundations' },
        { n: '02', name: 'Spacetime',    body: 'Lattice · Constants · Operators · CausalLattice',         dir: 'Spacetime' },
        { n: '03', name: 'Tensor',       body: 'Index-free tensor algebra on Z⁴',                         dir: 'Tensor' },
        { n: '04', name: 'Geometry',     body: 'Metric → Curvature → Hodge → Poincaré → Maxwell',         dir: 'Geometry' },
        { n: '05', name: 'Defects',      body: 'Topological defects + information content',               dir: 'Defects' },
        { n: '06', name: 'Conservation', body: 'Information · Noether · StressEnergy · Correspondence',   dir: 'Conservation' },
        { n: '07', name: 'HealingFlow',  body: 'Lyapunov · LaSalle · Convergence',                        dir: 'HealingFlow' },
        { n: '08', name: 'Emergence',    body: 'Einstein · QM Capstone · Higgs · Inflation · DarkMatter · Connes', dir: 'Emergence' },
        { n: '09', name: 'Predictions',  body: `PDG-anchored fits · ${HEADLINES.cyclesShipped} cycles`,    dir: 'Predictions', highlight: true },
        { n: '10', name: 'Torsion',      body: 'SpinTorsion · BigBounce (Popławski)',                     dir: 'Torsion' },
        { n: '11', name: 'Irrationality',body: 'π / e / √2 truncation · δ_comp(N)',                       dir: 'Irrationality' },
        { n: '12', name: 'Variational',  body: 'GraphAction · DiscreteNoether · InfoGeodesics',           dir: 'Variational' },
      ]).map((layer) => (
        <a
          class:list={['layer-card', { highlight: layer.highlight }]}
          href={`https://github.com/RamzesX/chaos-shield/tree/main/PhysicsPapers/LeanFormalizationV2/OmegaTheory/${layer.dir}`}
          target="_blank"
          rel="noopener"
          aria-label={`Open ${layer.name} Lean sources on GitHub (new tab)`}
        >
          <div class="layer-num">{layer.n}</div>
          <h3>{layer.name} <span class="layer-ext" aria-hidden="true">↗</span></h3>
          <p>{layer.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Why formal verification?</h2>
    <div class="reasons">
      <div class="reason">
        <div class="reason-mark">01</div>
        <div>
          <strong>No hidden errors.</strong>
          <p>Physics papers routinely contain algebraic gaps. Machine verification eliminates them.</p>
        </div>
      </div>
      <div class="reason">
        <div class="reason-mark">02</div>
        <div>
          <strong>Dependency tracking.</strong>
          <p>Lean explicitly records which theorems depend on which axioms. Change a postulate, see exactly what breaks.</p>
        </div>
      </div>
      <div class="reason">
        <div class="reason-mark">03</div>
        <div>
          <strong>Precision.</strong>
          <p>OmegaTheory makes quantitative predictions. Every number is backed by a Lean proof.</p>
        </div>
      </div>
      <div class="reason">
        <div class="reason-mark">04</div>
        <div>
          <strong>Reproducibility.</strong>
          <p><code>lake build</code> and verify. No authority required.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Build instructions</h2>
    <div class="code-block">
      <pre><code>git clone https://github.com/RamzesX/chaos-shield.git
cd chaos-shield/PhysicsPapers/LeanFormalizationV2

# download Mathlib cache (saves hours of compilation)
lake exe cache get

# build the whole project (~5 min on first run after cache get)
lake build --log-level=error</code></pre>
    </div>
    <p class="note">
      Requires <a href="https://leanprover-community.github.io/get_started.html" target="_blank" rel="noopener">Lean 4</a>
      and <a href="https://github.com/leanprover/elan" target="_blank" rel="noopener">elan</a>.
      Uses Lean v4.29.0 + Mathlib v4.29.0.
    </p>
  </section>

  <section class="cta-section">
    <a href={`${baseUrl}cycles/`} class="btn btn-primary">
      Browse the {HEADLINES.cyclesShipped}-cycle prediction catalogue
    </a>
    <a href={GH} class="btn btn-outline" target="_blank" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      View Lean source
    </a>
  </section>
</BaseLayout>

<style>
  .header-section {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 2px solid rgba(124, 77, 255, 0.2);
  }

  .header-eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    margin-bottom: var(--space-md);
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: var(--space-md);
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    border-bottom: 0;
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 52rem;
  }

  .stats-section {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-3xl);
  }

  .stat-card {
    background: var(--gradient-card);
