---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import { HEADLINES, fmt } from '../data/status.mjs';

const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const GH = 'https://github.com/RamzesX/chaos-shield/tree/main/PhysicsPapers/LeanFormalizationV2';
const GHB = 'https://github.com/RamzesX/chaos-shield/blob/main/PhysicsPapers/LeanFormalizationV2/OmegaTheory';

// Physics-domain breakdown — each subsection links to specific Lean theorem files.
// Updated 2026-04-27 with cycle-64 milestone (Real.pi_transcendental retired).
const physicsDomains = [
  {
    icon: '★',
    name: 'Cycle 64 milestone — π-transcendence retirement',
    accent: 'amber',
    blurb: 'Today (2026-04-27) the Real.pi_transcendental axiom became a theorem. First Lean 4 formalization of π-transcendence. 60-session autonomous proof; 14 hand-authored files; 4454 build jobs GREEN.',
    files: [
      { path: 'Capstones/Cycle64MasterCapstone.lean',                  label: 'Cycle64MasterCapstone',                 desc: '12-conjunct master' },
      { path: 'Capstones/PiTranscendenceAxiomRetirementFinal.lean',    label: 'PiTranscendenceAxiomRetirementFinal',   desc: '8-conjunct retirement headline' },
      { path: 'Capstones/PiHunchUnconditionalCapstone.lean',           label: 'PiHunchUnconditionalCapstone',          desc: 'π-Hunch thesis Lean-core only' },
      { path: 'Capstones/PiTranscendenceConsequences.lean',            label: 'PiTranscendenceConsequences',           desc: 'π^n irrationality results' },
      { path: 'Capstones/PiTranscendenceAlgebraicConsequences.lean',   label: 'PiTranscendenceAlgebraicConsequences',  desc: 'π+α and π·α (α algebraic)' },
