    blurb: 'G_μν = (8πG/c⁴)T_μν + O(ℓ_P) at healing-flow equilibrium. Flat, linearised, FRW, Bianchi-I, de Sitter, Kerr, static-spherical.',
    files: [
      { path: 'Emergence/EinsteinEmergence.lean',             label: 'EinsteinEmergence',           desc: 'vacuum Einstein 7 regimes' },
      { path: 'Geometry/Curvature.lean',                       label: 'Geometry/Curvature',          desc: 'Riemann + Ricci + scalar' },
      { path: 'Geometry/Hodge.lean',                           label: 'Geometry/Hodge',              desc: 'Hodge decomposition lattice' },
      { path: 'Conservation/StressEnergy.lean',                label: 'StressEnergy',                desc: '∂_μ T^μν = 0 from substrate' },
    ],
  },
  {
    icon: 'γ',
    name: 'U(1) — electromagnetism',
    accent: 'rose',
    blurb: 'Photon as massless connection on the lattice. Maxwell from differential forms.',
    files: [
      { path: 'Geometry/Maxwell.lean',                              label: 'Geometry/Maxwell',                desc: 'dF = 0 + d⋆F = J' },
      { path: 'Predictions/AlphaEM.lean',                           label: 'AlphaEM',                          desc: 'fine-structure α(m_Z)' },
      { path: 'Emergence/U1Photon.lean',                            label: 'U1Photon',                         desc: 'photonSubstrateMassBound_pos' },
    ],
  },
  {
    icon: 'W',
    name: 'SU(2) — weak force',
    accent: 'jade',
    blurb: 'Electroweak unification + W/Z boson masses + parity violation chirality.',
    files: [
      { path: 'Emergence/SU2WeakSector.lean',                       label: 'SU2WeakSector',                   desc: 'weakCouplingConstant_from_substrate' },
      { path: 'Predictions/WBosonMass.lean',                        label: 'WBosonMass',                       desc: 'm_W substrate fit' },
      { path: 'Emergence/ElectroweakUnification.lean',              label: 'ElectroweakUnification',           desc: 'cycle 24 EW unification' },
